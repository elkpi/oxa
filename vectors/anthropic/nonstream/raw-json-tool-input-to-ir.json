{
  "name": "anthropic.nonstream.raw-json-tool-input-to-ir",
  "description": "An Anthropic tool_use input object maps to the exact raw IR string token, preserving key order, whitespace, escapes, and numeric spelling (INV-1, N-AN-4).",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "id": "msg_raw",
    "type": "message",
    "role": "assistant",
    "model": "claude-sonnet-4-5",
    "content": [
      {
        "type": "tool_use",
        "id": "toolu_raw",
        "name": "inspect",
        "input": { "b" : "\u0041", "a" : 1e+01 }
      }
    ],
    "stop_reason": "tool_use",
    "usage": { "input_tokens": 1, "output_tokens": 2 }
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "id": "msg_raw",
    "model": "claude-sonnet-4-5",
    "content": [
      {
        "type": "tool_use",
        "id": "toolu_raw",
        "name": "inspect",
        "input": "{ \"b\" : \"\\u0041\", \"a\" : 1e+01 }"
      }
    ],
    "stop_reason": "tool_use",
    "usage": { "input_tokens": 1, "output_tokens": 2 }
  },
  "expected_losses": [],
  "tags": ["response", "tools", "raw-json", "n-an-4", "inv-1"]
}
