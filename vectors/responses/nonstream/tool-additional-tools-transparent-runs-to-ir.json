        "type": "message",
        "role": "user",
        "content": "go"
      },
      {
        "type": "function_call",
        "call_id": "f",
        "name": "clock",
        "arguments": "{}"
      },
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": []
      },
      {
        "type": "apply_patch_call",
        "call_id": "p",
        "status": "completed",
        "operation": {
          "type": "create_file",
          "path": "new.txt",
          "diff": "+hello\n"
        }
      },
      {
        "type": "function_call_output",
        "call_id": "f",
        "output": "ok"
      },
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": []
      },
      {
        "type": "apply_patch_call_output",
        "call_id": "p",
        "status": "completed",
        "output": ""
      }
    ]
  },
