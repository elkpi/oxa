{
  "name": "anthropic.nonstream.metadata-extra-key-request-from-ir",
  "description": "Encoding Request.Metadata to Anthropic keeps user_id and drops other keys.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "anthropic" },
  "input": {
    "specVersion": "0.2.0",
    "model": "claude-sonnet",
    "metadata": { "k": "v", "user_id": "u1" },
    "params": { "max_tokens": 16 },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_output": {
    "model": "claude-sonnet",
    "max_tokens": 16,
    "metadata": { "user_id": "u1" },
    "messages": [{ "role": "user", "content": "Hi" }]
  },
  "expected_losses": [
    {
      "path": "metadata.k",
      "field": "k",
      "reason": "unmapped-field",
      "detail": "Anthropic request metadata only preserves user_id; this IR metadata key is dropped."
    }
  ],
  "tags": ["request", "metadata", "loss", "N-AN-8"]
}
