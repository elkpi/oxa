{
  "name": "chatcompletions.nonstream.minimal-text-request-to-ir",
  "description": "Minimal Chat Completions text request maps to an IR request with one user text block.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [{ "role": "user", "content": "Hello" }]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hello" }] }
    ]
  },
  "expected_losses": [],
  "tags": ["text", "request", "minimal"]
}
