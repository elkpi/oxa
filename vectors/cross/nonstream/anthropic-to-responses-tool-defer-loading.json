{
  "name": "cross.nonstream.anthropic-to-responses-tool-defer-loading",
  "description": "Anthropic tool with defer_loading preserves defer_loading on Responses without loss (since 2.4.9).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "responses"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Call tool."
      }
    ],
    "tools": [
      {
        "name": "lookup",
        "description": "Search DB.",
        "input_schema": {
          "type": "object"
        },
        "defer_loading": true
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "input": "Call tool.",
    "max_output_tokens": 16000,
    "tools": [
      {
        "type": "function",
        "name": "lookup",
        "description": "Search DB.",
        "parameters": {
          "type": "object"
        },
        "defer_loading": true
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "cross",
    "request",
    "native",
    "tools",
    "defer_loading",
    "N-R-15"
  ]
}
