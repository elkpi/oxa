{
  "name": "anthropic.nonstream.thinking-budget-request-to-ir",
  "description": "Anthropic thinking budget_tokens maps to IR params.reasoning_effort with a degraded loss (N-AN-11).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-3-7-sonnet-20250219",
    "max_tokens": 16000,
    "messages": [{ "role": "user", "content": "Solve this puzzle." }],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 8192
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-3-7-sonnet-20250219",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Solve this puzzle." }] }
    ],
    "params": {
      "max_tokens": 16000,
      "reasoning_effort": "medium"
    },
    "native": [
      {
        "source": "anthropic",
        "kind": "thinking_mode",
        "value": "\"enabled\""
      },
      {
        "source": "anthropic",
        "kind": "thinking_budget",
        "value": "8192",
        "omission": {
          "field": "budget_tokens",
          "reason": "degraded",
          "detail": "budget approximated"
        },
        "projection": {
          "origin": "budget",
          "effort": "medium"
        }
      }
    ]
  },
  "expected_losses": [],
  "tags": ["params", "request", "thinking", "loss", "n-an-11"]
}
