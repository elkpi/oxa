{
  "name": "cross.nonstream.anthropic-to-chatcompletions-native-tools",
  "description": "目标不能表达来源限定工具时逐项报损，不伪造 function，也不保留悬空 named choice。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "m",
    "max_tokens": 32,
    "tools": [
      {
        "name": "lookup",
        "input_schema": {
          "type": "object"
        }
      },
      { "type" : "advisor_20260301", "name" : "advisor", "model" : "opus", "max_uses" : 2, "cache_control" : {"type":"ephemeral"}, "vendor_config" : {"budget":1e+03,"enabled":true} },
      {"type":"future_20990101","name":"future","config":{"opaque":[1,true,{"x":"y"}]}}
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "tool_choice": {
      "type": "tool",
      "name": "advisor"
    }
  },
  "expected_output": {
    "model": "m",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "max_tokens": 32,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup",
          "parameters": {
            "type": "object"
          }
        }
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tools[1]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "native tool \"advisor\" from \"anthropic\" cannot be represented by the target protocol"
    },
    {
      "path": "tools[2]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "native tool \"future\" from \"anthropic\" cannot be represented by the target protocol"
    },
    {
      "path": "tool_choice",
      "field": "tool_choice",
      "reason": "unsupported-semantic",
      "detail": "native tool choice \"advisor\" cannot be represented by the target protocol"
    }
  ],
  "tags": [
    "request",
    "tools",
    "native",
    "n-nt-1",
    "n-nt-2",
    "n-nt-3",
    "n-nt-4"
  ]
}
