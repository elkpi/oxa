{
  "name": "anthropic.nonstream.multiturn-request-from-ir",
  "description": "A three-message IR conversation renders as Anthropic block-content messages.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "anthropic" },
  "input": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is 2+2?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "4" }] },
      { "role": "user", "content": [{ "type": "text", "text": "And 3+3?" }] }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_output": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is 2+2?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "4" }] },
      { "role": "user", "content": [{ "type": "text", "text": "And 3+3?" }] }
    ]
  },
  "expected_losses": [],
  "tags": ["multiturn", "request"]
}
