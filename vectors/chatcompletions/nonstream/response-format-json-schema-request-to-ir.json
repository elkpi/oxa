{
  "name": "chatcompletions.nonstream.response-format-json-schema-request-to-ir",
  "description": "Chat Completions response_format json_schema unwraps to IR params.response_format (N-CC-13).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o",
    "messages": [{ "role": "user", "content": "Extract user info." }],
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "user_info",
        "description": "User profile schema",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "integer" }
          },
          "required": ["name", "age"],
          "additionalProperties": false
        },
        "strict": false
      }
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Extract user info." }] }
    ],
    "params": {
      "response_format": {
        "type": "json_schema",
        "name": "user_info",
        "description": "User profile schema",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "integer" }
          },
          "required": ["name", "age"],
          "additionalProperties": false
        },
        "strict": false
      }
    }
  },
  "expected_losses": [],
  "tags": ["params", "request", "response_format", "n-cc-13"]
}
