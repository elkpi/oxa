{
  "name": "responses.nonstream.developer-message-request-to-ir",
  "description": "A developer message is preserved as an IR system block with developer role.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "responses"
  },
  "input": {
    "model": "m",
    "input": [
      {
        "type": "message",
        "role": "developer",
        "content": "Follow developer instructions.\n"
      },
      {
        "role": "user",
        "content": "Hi"
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "m",
    "system": [
      {
        "type": "text",
        "text": "Follow developer instructions.\n",
        "role": "developer"
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hi"
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "developer",
    "system",
    "request",
    "loss",
    "N-R-1"
  ]
}
