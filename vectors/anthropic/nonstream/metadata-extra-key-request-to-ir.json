{
  "name": "anthropic.nonstream.metadata-extra-key-request-to-ir",
  "description": "Anthropic metadata keeps user_id and drops every other key.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet",
    "max_tokens": 16,
    "metadata": { "user_id": "u1", "extra": "x" },
    "messages": [{ "role": "user", "content": "Hi" }]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-sonnet",
    "metadata": { "user_id": "u1" },
    "params": { "max_tokens": 16 },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_losses": [
    {
      "path": "metadata.extra",
      "field": "extra",
      "reason": "unmapped-field",
      "detail": "Anthropic request metadata only preserves user_id; this key is dropped."
    }
  ],
  "tags": ["request", "metadata", "loss", "N-AN-8"]
}
