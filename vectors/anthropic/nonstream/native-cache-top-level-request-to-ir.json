{
  "name": "anthropic.nonstream.native-cache-top-level-request-to-ir",
  "description": "Top-level request cache_control is preserved as native IR option without decode loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "cache_control": {
      "type": "ephemeral"
    },
    "messages": [
      {
        "role": "user",
        "content": "Hi."
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hi."
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 16000
    },
    "native": [
      {
        "source": "anthropic",
        "kind": "cache_control",
        "value": "{\"type\":\"ephemeral\"}",
        "omission": {
          "field": "cache_control",
          "reason": "unmapped-field"
        }
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "request",
    "cache-control",
    "native"
  ]
}
