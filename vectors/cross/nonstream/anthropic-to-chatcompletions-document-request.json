{
  "name": "cross.nonstream.anthropic-to-chatcompletions-document-request",
  "description": "Cross-protocol: an Anthropic document block converts to Chat Completions as file content part; metadata annotations record omission losses per spec/15 §3.5, and the document content survives.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "document",
            "source": {
              "type": "base64",
              "media_type": "application/pdf",
              "data": "JVBERi0xLjcK"
            },
            "title": "Q3 Report",
            "context": "financial filing",
            "citations": {
              "enabled": true
            },
            "cache_control": {
              "type": "ephemeral"
            }
          },
          {
            "type": "text",
            "text": "Summarize the documents."
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "file",
            "file": {
              "file_data": "JVBERi0xLjcK"
            }
          },
          {
            "type": "text",
            "text": "Summarize the documents."
          }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0].native[0]",
      "field": "title",
      "reason": "unmapped-field",
      "detail": "anthropic-native document title; the target face has no document representation"
    },
    {
      "path": "messages[0].content[0].native[1]",
      "field": "context",
      "reason": "unmapped-field",
      "detail": "anthropic-native document context; the target face has no document representation"
    },
    {
      "path": "messages[0].content[0].native[2]",
      "field": "citations",
      "reason": "unsupported-semantic",
      "detail": "anthropic-native document citations; citations alter response semantics and the target face has no document representation"
    },
    {
      "path": "messages[0].content[0].native[3]",
      "field": "cache_control",
      "reason": "unmapped-field",
      "detail": "anthropic-native cache breakpoint; the target face has no cache_control representation"
    }
  ],
  "tags": [
    "cross",
    "document",
    "request",
    "n-an-16",
    "n-cc-14"
  ]
}
