{
  "name": "jev.nonstream.box-answer-loss-response-to-ir",
  "description": "An experimental box answer is carried verbatim in the answers text but records one unsupported-semantic loss; the supported noul answer proceeds.",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "jev"
  },
  "input": {
    "model": "jev-latest",
    "answers": {
      "locate": {
        "type": "box",
        "box": {
          "top": 0.1,
          "bottom": 0.4,
          "left": 0.2,
          "right": 0.6
        },
        "confidence": 0.7
      },
      "damaged": {
        "type": "noul",
        "noul": 1
      }
    },
    "usage": {
      "input_tokens": 88,
      "output_tokens": 12
    }
  },
  "expected_ir": {
    "specVersion": "0.3.0",
    "id": "jev",
    "model": "jev-latest",
    "content": [
      {
        "type": "text",
        "text": "{\"damaged\":{\"noul\":1,\"type\":\"noul\"},\"locate\":{\"box\":{\"top\":0.1,\"bottom\":0.4,\"left\":0.2,\"right\":0.6},\"confidence\":0.7,\"type\":\"box\"}}"
      }
    ],
    "stop_reason": "end_turn",
    "usage": {
      "input_tokens": 88,
      "output_tokens": 12
    }
  },
  "expected_losses": [
    {
      "path": "answers.locate",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "N-JEV-5: experimental box answers are carried verbatim"
    }
  ],
  "tags": [
    "response",
    "loss",
    "experimental"
  ]
}
