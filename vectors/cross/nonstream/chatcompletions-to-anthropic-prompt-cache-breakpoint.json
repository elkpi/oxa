{
  "name": "cross.nonstream.chatcompletions-to-anthropic-prompt-cache-breakpoint",
  "description": "Cross encoding from Chat Completions to Anthropic: prompt_cache_breakpoint reports unmapped-field loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0].native[0]",
      "field": "prompt_cache_breakpoint",
      "reason": "unmapped-field",
      "detail": "Anthropic Messages has no prompt_cache_breakpoint parameter; prompt cache breakpoint is dropped"
    }
  ],
  "tags": ["cross", "request", "chatcompletions", "anthropic", "prompt_cache_breakpoint"]
}
