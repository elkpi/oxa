{
  "name": "responses.nonstream.tool-nested-container-from-ir",
  "description": "IR tools with multi-level container path native annotation reconstruct full nested toolbox and namespace hierarchy with descriptions on encode.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "responses" },
