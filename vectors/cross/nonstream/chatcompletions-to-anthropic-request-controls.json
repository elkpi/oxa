{
  "name": "cross.nonstream.chatcompletions-to-anthropic-request-controls",
  "description": "Cross encoding from Chat Completions to Anthropic: max_completion_tokens maps to max_tokens, store false and stream true produce zero loss, stream_options produces degraded loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "chatcompletions"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "max_completion_tokens": 1024,
    "store": false,
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ]
  },
  "expected_losses": [
    {
      "path": "native[3]",
      "field": "stream_options",
      "reason": "degraded",
      "detail": "target does not emit the requested final usage chunk"
    }
  ],
  "tags": [
    "cross",
    "request",
    "chatcompletions",
    "anthropic",
    "controls",
    "native",
    "loss"
  ]
}
