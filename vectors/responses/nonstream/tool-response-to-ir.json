{
  "name": "responses.nonstream.tool-response-to-ir",
  "description": "A completed response with message and function_call output items maps to IR text and tool_use blocks with stop_reason tool_use.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "id": "resp_2",
    "object": "response",
    "status": "completed",
    "model": "gpt-4o-mini",
    "output": [
      {
        "type": "message",
        "id": "msg_1",
        "role": "assistant",
        "status": "completed",
        "content": [{ "type": "output_text", "text": "Checking.", "annotations": [] }]
      },
      {
        "type": "function_call",
        "id": "fc_1",
        "status": "completed",
        "call_id": "call_9",
        "name": "weather",
        "arguments": "{\"city\":\"Paris\"}"
      }
    ],
    "usage": { "input_tokens": 10, "output_tokens": 5, "total_tokens": 15 }
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "id": "resp_2",
    "model": "gpt-4o-mini",
    "content": [
      { "type": "text", "text": "Checking." },
      { "type": "tool_use", "id": "call_9", "name": "weather", "input": "{\"city\":\"Paris\"}" }
    ],
    "stop_reason": "tool_use",
    "usage": { "input_tokens": 10, "output_tokens": 5 }
  },
  "expected_losses": [],
  "tags": ["tools", "response", "N-R-5", "N-R-11"]
}
