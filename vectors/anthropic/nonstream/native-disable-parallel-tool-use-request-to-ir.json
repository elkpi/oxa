{
  "name": "anthropic.nonstream.native-disable-parallel-tool-use-request-to-ir",
  "description": "tool_choice.disable_parallel_tool_use is preserved in IR tool_choice.disable_parallel and native IR option without decode loss (N-AN-19).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Weather in Paris?"
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": { "type": "string" }
          }
        }
      }
    ],
    "tool_choice": {
      "type": "auto",
      "disable_parallel_tool_use": true
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Weather in Paris?"
          }
        ]
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": { "type": "string" }
          }
        }
      }
    ],
    "tool_choice": {
      "mode": "auto",
      "disable_parallel": true
    },
    "params": {
      "max_tokens": 1024
    },
    "native": [
      {
        "source": "anthropic",
        "kind": "disable_parallel_tool_use",
        "value": "true",
        "omission": {
          "field": "disable_parallel_tool_use",
          "reason": "unmapped-field"
        }
      }
    ]
  },
  "expected_losses": [],
  "tags": ["request", "tools", "native"]
}
