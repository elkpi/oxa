{
  "name": "anthropic.nonstream.params-request-to-ir",
  "description": "temperature, top_p, max_tokens and stop_sequences map to the IR params object.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 300,
    "temperature": 0.5,
    "top_p": 0.9,
    "stop_sequences": ["\n\n", "END"],
    "messages": [{ "role": "user", "content": "Hello" }]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hello" }] }
    ],
    "params": {
      "temperature": 0.5,
      "top_p": 0.9,
      "max_tokens": 300,
      "stop_sequences": ["\n\n", "END"]
    }
  },
  "expected_losses": [],
  "tags": ["params", "request"]
}
