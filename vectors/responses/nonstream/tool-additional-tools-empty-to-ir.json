{
  "name": "responses.nonstream.tool-additional-tools-empty-to-ir",
  "description": "An empty Responses additional_tools inventory is a no-op and records one bounded unmapped-field loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "model": "gpt-5.5",
    "input": [
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": []
      },
      {
        "type": "message",
        "role": "user",
        "content": "hello"
      }
    ],
    "tools": [
      {
        "type": "function",
        "name": "existing",
        "parameters": {
          "type": "object"
        }
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "hello"
          }
        ]
      }
    ],
    "tools": [
      {
        "name": "existing",
        "input_schema": {
          "type": "object"
        }
      }
    ]
  },
  "expected_losses": [
    {
      "path": "input[0].tools",
      "field": "tools",
      "reason": "unmapped-field",
      "detail": "empty additional_tools inventory ignored"
    }
  ],
  "tags": ["tools", "request", "additional_tools", "N-R-15"]
}
