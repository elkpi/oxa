{
  "name": "cross.nonstream.anthropic-to-chatcompletions-redacted-thinking-request",
  "description": "Cross-protocol: Anthropic request with redacted_thinking block converts to Chat Completions dropping the block with unsupported-semantic loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 4096,
    "messages": [
      {
        "role": "user",
        "content": "Recall past reasoning."
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "redacted_thinking",
            "data": "OPAQUE_ENCRYPTED_TEST_PAYLOAD"
          },
          {
            "type": "text",
            "text": "Continuing from prior context."
          }
        ]
      },
      {
        "role": "user",
        "content": "Proceed."
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 4096,
    "messages": [
      {
        "role": "user",
        "content": "Recall past reasoning."
      },
      {
        "role": "assistant",
        "content": "Continuing from prior context."
      },
      {
        "role": "user",
        "content": "Proceed."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[1].content[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "anthropic encrypted thinking replay state; the target face cannot preserve this block"
    }
  ],
  "tags": ["cross", "thinking", "redacted_thinking", "request", "n-an-17"]
}
