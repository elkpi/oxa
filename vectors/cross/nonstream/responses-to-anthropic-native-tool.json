{
  "name": "cross.nonstream.responses-to-anthropic-native-tool",
  "description": "OpenAI native tool in Responses is omitted when converted to Anthropic with unsupported-semantic loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "gpt-5.5",
    "input": "Search web.",
    "tools": [
      {
        "type": "web_search"
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": "Search web."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tools[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "native tool \"web_search\" from \"openai\" cannot be represented by the target protocol"
    }
  ],
  "tags": ["cross", "request", "native", "N-R-15", "n-nt-3", "n-nt-5"]
}
