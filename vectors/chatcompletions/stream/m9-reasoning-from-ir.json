{
  "name": "chatcompletions.stream.m9-reasoning-from-ir",
  "description": "An IR stream with thinking and text deltas encodes to Chat Completions chunks emitting reasoning_content and content deltas and token details on the finish chunk (N-S-11, N-CC-12).",
  "spec_version": "0.2.0",
  "mode": "stream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.2.0",
    "events": [
      { "type": "message_start", "id": "chatcmpl-from-think", "model": "o3-mini" },
      { "type": "content_block_start", "index": 0, "block": { "type": "thinking", "thinking": "" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "text": "Reasoning " } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "text": "text." } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "content_block_start", "index": 1, "block": { "type": "text", "text": "" } },
      { "type": "content_block_delta", "index": 1, "delta": { "type": "text_delta", "text": "Answer." } },
      { "type": "content_block_stop", "index": 1 },
      { "type": "message_delta", "stop_reason": "end_turn", "usage": { "input_tokens": 8, "output_tokens": 12, "input_tokens_details": { "cached_tokens": 4 }, "output_tokens_details": { "reasoning_tokens": 8 } } },
      { "type": "message_done" }
    ]
  },
  "expected_output": {
    "events": [
      { "id": "chatcmpl-from-think", "object": "chat.completion.chunk", "created": 0, "model": "o3-mini", "choices": [{ "index": 0, "delta": { "role": "assistant" }, "finish_reason": null }] },
      { "id": "chatcmpl-from-think", "object": "chat.completion.chunk", "created": 0, "model": "o3-mini", "choices": [{ "index": 0, "delta": { "reasoning_content": "Reasoning " }, "finish_reason": null }] },
      { "id": "chatcmpl-from-think", "object": "chat.completion.chunk", "created": 0, "model": "o3-mini", "choices": [{ "index": 0, "delta": { "reasoning_content": "text." }, "finish_reason": null }] },
      { "id": "chatcmpl-from-think", "object": "chat.completion.chunk", "created": 0, "model": "o3-mini", "choices": [{ "index": 0, "delta": { "content": "Answer." }, "finish_reason": null }] },
      { "id": "chatcmpl-from-think", "object": "chat.completion.chunk", "created": 0, "model": "o3-mini", "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }], "usage": { "prompt_tokens": 8, "completion_tokens": 12, "total_tokens": 20, "prompt_tokens_details": { "cached_tokens": 4 }, "completion_tokens_details": { "reasoning_tokens": 8 } } }
    ]
  },
  "expected_losses": [],
  "tags": ["stream", "thinking", "m9", "n-s-11", "n-cc-12"]
}
