{
  "name": "cross.nonstream.anthropic-to-chatcompletions-text-citations-response",
  "description": "Cross-protocol: Anthropic response text with citations converts to Chat Completions dropping citations with unsupported-semantic loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "id": "msg_cite_cross_cc",
    "type": "message",
    "role": "assistant",
    "model": "claude-sonnet-4-6",
    "content": [
      {
        "type": "text",
        "text": "Answer citing sources.",
        "citations": [
          {
            "type": "char_location",
            "cited_text": "sample source",
            "document_index": 0,
            "document_title": "Doc",
            "start_char_index": 0,
            "end_char_index": 13,
            "file_id": null
          }
        ]
      }
    ],
    "stop_reason": "end_turn",
    "usage": {
      "input_tokens": 10,
      "output_tokens": 20
    }
  },
  "expected_output": {
    "id": "msg_cite_cross_cc",
    "object": "chat.completion",
    "created": 0,
    "model": "claude-sonnet-4-6",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "Answer citing sources."
        },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 10,
      "completion_tokens": 20,
      "total_tokens": 30
    }
  },
  "expected_losses": [
    {
      "path": "content[0].citations",
      "field": "citations",
      "reason": "unsupported-semantic",
      "detail": "anthropic text citations; the target face cannot preserve source locations and replay metadata"
    }
  ],
  "tags": ["cross", "citations", "text", "response", "n-an-18"]
}
