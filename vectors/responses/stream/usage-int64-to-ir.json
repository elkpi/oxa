{
  "name": "responses.stream.usage-int64-to-ir",
  "description": "A Responses terminal event preserves signed int64 maximum token counts exactly in final IR usage (N-S-1).",
  "spec_version": "0.1.0",
  "mode": "stream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "events": [
      { "type": "response.created", "response": { "id": "resp_usage", "object": "response", "status": "in_progress", "model": "gpt-4o-mini", "output": [] } },
      { "type": "response.completed", "response": { "id": "resp_usage", "object": "response", "status": "completed", "model": "gpt-4o-mini", "output": [], "usage": { "input_tokens": 9223372036854775807, "output_tokens": 0, "total_tokens": 9223372036854775807 } } }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "events": [
      { "type": "message_start", "id": "resp_usage", "model": "gpt-4o-mini" },
      { "type": "message_delta", "stop_reason": "end_turn", "usage": { "input_tokens": 9223372036854775807, "output_tokens": 0 } },
      { "type": "message_done" }
    ]
  },
  "expected_losses": [],
  "tags": ["stream", "usage", "int64", "n-s-1"]
}
