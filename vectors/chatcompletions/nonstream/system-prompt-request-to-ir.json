{
  "name": "chatcompletions.nonstream.system-prompt-request-to-ir",
  "description": "A Chat Completions top-level system message becomes the IR system block list.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "system", "content": "You are a terse assistant." },
      { "role": "user", "content": "Hi" }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "system": [{ "type": "text", "text": "You are a terse assistant." }],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_losses": [],
  "tags": ["system", "request"]
}
