{
  "name": "anthropic.nonstream.loss-unknown-document-source-to-ir",
  "description": "A document whose source.type is out of contract (content) drops as one whole-block unsupported-semantic loss while a sibling file-source document decodes normally (N-AN-9, N-AN-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "document",
            "source": {
              "type": "content",
              "content": "plain text document"
            }
          },
          {
            "type": "text",
            "text": "Summarize."
          },
          {
            "type": "document",
            "source": {
              "type": "file",
              "file_id": "file_ok"
            }
          }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarize."
          },
          {
            "type": "document",
            "file_id": "file_ok"
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 1024
    }
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "Anthropic document source type \"content\" has no IR equivalent"
    }
  ],
  "tags": [
    "loss",
    "document",
    "request",
    "n-an-9",
    "n-an-16"
  ]
}
