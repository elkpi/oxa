{
  "name": "responses.nonstream.document-filename-detail-loss-request-to-ir",
  "description": "Responses request input_file with filename and detail reports unmapped-field losses (N-R-19).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "model": "gpt-4o",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_file",
            "file_id": "file_123",
            "filename": "report.pdf",
            "detail": "high"
          }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "document", "file_id": "file_123" }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "input[0].content[0].filename",
      "field": "filename",
      "reason": "unmapped-field",
      "detail": "Responses input_file filename has no IR equivalent"
    },
    {
      "path": "input[0].content[0].detail",
      "field": "detail",
      "reason": "unmapped-field",
      "detail": "Responses input_file detail has no IR equivalent"
    }
  ],
  "tags": ["document", "request", "N-R-19", "loss"]
}
