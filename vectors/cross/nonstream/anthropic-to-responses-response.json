{
  "name": "cross.nonstream.anthropic-to-responses-response",
  "description": "Cross-protocol: a Anthropic Messages response (text plus one tool call, tool_use stop reason, usage) converted to a Responses response through the IR.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "anthropic"},
  "target": {"protocol": "responses"},
  "input": {"id": "msg_x1", "type": "message", "role": "assistant", "model": "claude-sonnet-4-5", "content": [{"type": "text", "text": "Checking the weather."}, {"type": "tool_use", "id": "toolu_1", "name": "get_weather", "input": {"city": "Paris"}}], "stop_reason": "tool_use", "usage": {"input_tokens": 10, "output_tokens": 25}},
  "expected_output": {"id": "msg_x1", "object": "response", "status": "completed", "model": "claude-sonnet-4-5", "output": [{"type": "message", "id": "msg_abc123", "status": "completed", "role": "assistant", "content": [{"type": "output_text", "text": "Checking the weather.", "annotations": []}]}, {"type": "function_call", "id": "fc_abc123", "status": "completed", "call_id": "toolu_1", "name": "get_weather", "arguments": "{\"city\": \"Paris\"}"}], "usage": {"input_tokens": 10, "output_tokens": 25, "total_tokens": 35}},
  "expected_losses": [],
  "tags": ["cross", "tools", "response", "usage"]
}
