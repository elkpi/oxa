{
  "name": "cross.nonstream.responses-to-anthropic-additional-tools-request",
  "description": "Cross-protocol: Responses input additional_tools items are hoisted and convert to Anthropic request tools (N-R-15).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "gpt-5.5",
    "max_output_tokens": 1024,
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": "Use additional tool."
      },
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": [
          {
            "type": "function",
            "name": "calc",
            "description": "Calculator",
            "parameters": {
              "type": "object"
            },
            "strict": true
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5.5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Use additional tool."
      }
    ],
    "tools": [
      {
        "name": "calc",
        "description": "Calculator",
        "input_schema": {
          "type": "object"
        },
        "strict": true
      }
    ]
  },
  "expected_losses": [],
  "tags": ["cross", "tools", "request", "additional_tools", "N-R-15"]
}
