{
  "name": "anthropic.nonstream.custom-tool-declaration-choice-from-ir",
  "description": "N-AN-13：IR Custom Tool 声明与 choice 转换为 Anthropic Messages 结构化包装工具。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "specVersion": "0.2.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "hello"
          }
        ]
      }
    ],
    "tools": [
      {
        "type": "custom",
        "name": "code_exec",
        "description": "Executes text verbatim.",
        "format": {
          "type": "text"
        }
      }
    ],
    "tool_choice": {
      "mode": "tool",
      "name": "code_exec",
      "tool_type": "custom"
    },
    "params": {
      "max_tokens": 1024
    }
  },
  "expected_losses": [],
  "tags": [
    "custom-tools",
    "n-an-13"
  ],
  "target": {
    "protocol": "anthropic"
  },
  "expected_output": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "hello"
      }
    ],
    "tools": [
      {
        "name": "code_exec",
        "description": "Executes text verbatim.",
        "input_schema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    ],
    "tool_choice": {
      "type": "tool",
      "name": "code_exec"
    }
  }
}
