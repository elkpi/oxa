{
  "name": "anthropic.nonstream.tool-choice-named-to-ir",
  "description": "Anthropic tool_choice {type:tool, name} maps to IR tool-choice mode tool with the name.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": { "type": "tool", "name": "get_weather" }
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "Weather in Paris?" }] }],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": { "mode": "tool", "name": "get_weather" },
    "params": { "max_tokens": 1024 }
  },
  "expected_losses": [],
  "tags": ["tools", "request", "tool-choice", "n-an-6"]
}
