{
  "name": "chatcompletions.nonstream.thinking-response-from-ir",
  "description": "An IR response with a ThinkingBlock containing a signature renders to Chat Completions with reasoning_content and records an unmapped-field loss for signature.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.2.0",
    "id": "chatcmpl-reasoning123",
    "model": "o3-mini",
    "content": [
      {
        "type": "thinking",
        "thinking": "Calculating the answer to life...",
        "signature": "sig_opaque_from_provider"
      },
      { "type": "text", "text": "42 is the answer." }
    ],
    "stop_reason": "end_turn",
    "usage": { "input_tokens": 10, "output_tokens": 20 }
  },
  "expected_output": {
    "id": "chatcmpl-reasoning123",
    "object": "chat.completion",
    "created": 0,
    "model": "o3-mini",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "42 is the answer.",
          "reasoning_content": "Calculating the answer to life..."
        },
        "finish_reason": "stop"
      }
    ],
    "usage": { "prompt_tokens": 10, "completion_tokens": 20, "total_tokens": 30 }
  },
  "expected_losses": [
    {
      "path": "content[0].signature",
      "field": "signature",
      "reason": "unmapped-field"
    }
  ],
  "tags": ["response", "thinking", "loss", "n-cc-12"]
}
