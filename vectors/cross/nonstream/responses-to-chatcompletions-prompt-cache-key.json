{
  "name": "cross.nonstream.responses-to-chatcompletions-prompt-cache-key",
  "description": "Cross encoding from Responses to Chat Completions: prompt_cache_key maps loss-free.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o",
    "input": "Hello",
    "prompt_cache_key": "tenant-42"
  },
  "expected_output": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "prompt_cache_key": "tenant-42"
  },
  "expected_losses": [],
  "tags": ["cross", "request", "responses", "chatcompletions", "prompt_cache_key"]
}
