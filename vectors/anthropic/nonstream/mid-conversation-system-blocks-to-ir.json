{
  "name": "anthropic.nonstream.mid-conversation-system-blocks-to-ir",
  "description": "A mid-conversation system message with text blocks preserves cache_control as a native annotation and records the degraded role loss.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "system": [{ "type": "text", "text": "You are a helpful assistant." }],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is the capital of France?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "Paris." }] },
      { "role": "user", "content": [{ "type": "text", "text": "Now summarize." }] },
      {
        "role": "system",
        "content": [
          { "type": "text", "text": "Terse mode enabled.", "cache_control": { "type": "ephemeral" } },
          { "type": "text", "text": "Keep responses under 40 words." }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-opus-5-5",
    "system": [
      { "type": "text", "text": "You are a helpful assistant." },
      {
        "type": "text",
        "text": "Terse mode enabled.",
        "native": [
          {
            "source": "anthropic",
            "kind": "cache_control",
            "value": "{\"type\":\"ephemeral\"}",
            "omission": {
              "field": "cache_control",
              "reason": "unmapped-field",
              "detail": "anthropic-native cache breakpoint; the target face has no cache_control representation"
            }
          }
        ]
      },
      { "type": "text", "text": "Keep responses under 40 words." }
    ],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is the capital of France?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "Paris." }] },
      { "role": "user", "content": [{ "type": "text", "text": "Now summarize." }] }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_losses": [
    {
      "path": "messages[3].role",
      "field": "role",
      "reason": "degraded",
      "detail": "Anthropic mid-conversation system message is carried as request-level system content; mid-conversation position is not preserved."
    }
  ],
  "tags": ["system", "request", "N-AN-15"]
}
