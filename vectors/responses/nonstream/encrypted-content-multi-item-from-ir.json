{
  "name": "responses.nonstream.encrypted-content-multi-item-from-ir",
  "description": "IR alternating ThinkingBlock and EncryptedContentBlock pairs encode back to separate Responses reasoning items, each carrying its own summary and encrypted_content (N-R-13).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "responses" },
  "target": { "protocol": "responses" },
  "input": {
    "specVersion": "0.2.0",
    "id": "resp_multi_cipher",
    "model": "o3-mini",
    "content": [
      { "type": "thinking", "thinking": "first pass" },
      { "type": "encrypted_content", "data": "CIPHER_ONE" },
      { "type": "thinking", "thinking": "second pass" },
      { "type": "encrypted_content", "data": "CIPHER_TWO" },
      { "type": "text", "text": "Done." }
    ],
    "stop_reason": "end_turn",
    "usage": { "input_tokens": 5, "output_tokens": 9 }
  },
  "expected_output": {
    "id": "resp_multi_cipher",
    "object": "response",
    "status": "completed",
    "model": "o3-mini",
    "output": [
      {
        "type": "reasoning",
        "id": "rs_abc123",
        "summary": [{ "type": "output_text", "text": "first pass", "annotations": [] }],
        "encrypted_content": "CIPHER_ONE"
      },
      {
        "type": "reasoning",
        "id": "rs_abc124",
        "summary": [{ "type": "output_text", "text": "second pass", "annotations": [] }],
        "encrypted_content": "CIPHER_TWO"
      },
      {
        "type": "message",
        "id": "msg_abc123",
        "role": "assistant",
        "status": "completed",
        "content": [{ "type": "output_text", "text": "Done.", "annotations": [] }]
      }
    ],
    "usage": { "input_tokens": 5, "output_tokens": 9, "total_tokens": 14 }
  },
  "expected_losses": [],
  "tags": ["response", "thinking", "encrypted-content", "n-r-13"]
}
