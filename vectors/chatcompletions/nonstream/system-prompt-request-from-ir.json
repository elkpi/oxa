{
  "name": "chatcompletions.nonstream.system-prompt-request-from-ir",
  "description": "An IR system block list renders as a leading Chat Completions system message.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "system": [{ "type": "text", "text": "You are a terse assistant." }],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_output": {
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "system", "content": "You are a terse assistant." },
      { "role": "user", "content": "Hi" }
    ]
  },
  "expected_losses": [],
  "tags": ["system", "request"]
}
