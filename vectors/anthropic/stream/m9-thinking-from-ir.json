{
  "name": "anthropic.stream.m9-thinking-from-ir",
  "description": "An IR stream with a thinking block encodes to native Anthropic stream events with an empty thinking start, thinking deltas, signature delta, text deltas, and usage including cache tokens (N-S-11).",
  "spec_version": "0.2.0",
  "mode": "stream",
  "conversion": "from-ir",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "anthropic" },
  "input": {
    "specVersion": "0.2.0",
    "events": [
      { "type": "message_start", "id": "msg_think_from", "model": "claude-3-7-sonnet-20250219" },
      { "type": "content_block_start", "index": 0, "block": { "type": "thinking", "thinking": "Thinking carefully.", "signature": "sig_abc" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "text": "Thinking " } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "text": "carefully." } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "signature_delta", "signature": "sig_abc" } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "content_block_start", "index": 1, "block": { "type": "text", "text": "" } },
      { "type": "content_block_delta", "index": 1, "delta": { "type": "text_delta", "text": "42" } },
      { "type": "content_block_stop", "index": 1 },
      { "type": "message_delta", "stop_reason": "end_turn", "usage": { "input_tokens": 10, "output_tokens": 15, "cache_creation_input_tokens": 5, "cache_read_input_tokens": 20 } },
      { "type": "message_done" }
    ]
  },
  "expected_output": {
    "events": [
      { "type": "message_start", "message": { "id": "msg_think_from", "type": "message", "role": "assistant", "model": "claude-3-7-sonnet-20250219", "content": [], "stop_reason": null, "usage": { "input_tokens": 0, "output_tokens": 0 } } },
      { "type": "content_block_start", "index": 0, "content_block": { "type": "thinking" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "thinking": "Thinking " } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "thinking_delta", "thinking": "carefully." } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "signature_delta", "signature": "sig_abc" } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "content_block_start", "index": 1, "content_block": { "type": "text" } },
      { "type": "content_block_delta", "index": 1, "delta": { "type": "text_delta", "text": "42" } },
      { "type": "content_block_stop", "index": 1 },
      { "type": "message_delta", "delta": { "stop_reason": "end_turn" }, "usage": { "input_tokens": 10, "output_tokens": 15, "cache_creation_input_tokens": 5, "cache_read_input_tokens": 20 } },
      { "type": "message_stop" }
    ]
  },
  "expected_losses": [],
  "tags": ["stream", "thinking", "m9", "n-s-11"]
}
