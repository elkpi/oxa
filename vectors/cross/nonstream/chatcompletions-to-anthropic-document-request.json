{
  "name": "cross.nonstream.chatcompletions-to-anthropic-document-request",
  "description": "Cross-protocol: Chat Completions file part with file_data converts losslessly to Anthropic document with base64 source (N-CC-14, N-AN-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "gpt-4o",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "file", "file": { "file_data": "JVBERi0xLjcK" } },
          { "type": "text", "text": "Extract text." }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-4o",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "document",
            "source": {
              "type": "base64",
              "media_type": "application/pdf",
              "data": "JVBERi0xLjcK"
            }
          },
          {
            "type": "text",
            "text": "Extract text."
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["cross", "document", "request", "n-cc-14", "n-an-16"]
}
