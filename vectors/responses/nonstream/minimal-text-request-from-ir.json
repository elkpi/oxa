{
  "name": "responses.nonstream.minimal-text-request-from-ir",
  "description": "A minimal single-text-block IR request renders as a Responses request with string input.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "responses" },
  "target": { "protocol": "responses" },
  "input": {
