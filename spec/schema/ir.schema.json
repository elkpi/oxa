{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elkpi/oxa/spec/schema/ir.schema.json",
  "title": "oxa IR document",
  "description": "Validates one IR document: a request, a response, or an event stream, as defined by spec/01-intermediate-representation.md. Only per-document structure is checked here; sequence rules (INV-2..INV-6, INV-8) are enforced by converters and vector checking, not by JSON Schema (INV-9).",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/eventStream" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "description": "IR request document (spec/01 s3.1).",
      "properties": {
        "specVersion": {
          "enum": ["0.1.0", "0.2.0"],
          "description": "Spec version this document conforms to (document-layer field)."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque model identifier; passed through verbatim (spec/03)."
        },
        "system": {
          "type": "array",
          "items": { "$ref": "#/$defs/systemBlock" },
          "description": "System prompt blocks; absent means no system prompt."
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" },
          "description": "Conversation turns; INV-2..INV-4 apply."
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" },
          "description": "Tool definitions."
        },
        "tool_choice": {
          "$ref": "#/$defs/toolChoice"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "String-to-string map."
        },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" },
          "description": "Provider-specific request annotations (spec/15)."
        }
      },
      "required": ["specVersion", "model", "messages"],
      "additionalProperties": false
    },
    "systemBlock": {
      "type": "object",
      "description": "System prompt block with optional native request annotations (spec/01, spec/15).",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "description": "IR message (spec/01 s3.3).",
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requestBlock" }
        }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "requestBlock": {
      "description": "Sealed union of request content block types, permitted to carry native request annotations (spec/01, spec/15).",
      "oneOf": [
        { "$ref": "#/$defs/requestTextBlock" },
        { "$ref": "#/$defs/requestImageBlock" },
        { "$ref": "#/$defs/requestDocumentBlock" },
        { "$ref": "#/$defs/requestToolUseBlock" },
        { "$ref": "#/$defs/requestToolResultBlock" },
        { "$ref": "#/$defs/requestThinkingBlock" },
        { "$ref": "#/$defs/requestRedactedThinkingBlock" },
        { "$ref": "#/$defs/requestCustomToolUseBlock" },
        { "$ref": "#/$defs/requestCustomToolResultBlock" },
        { "$ref": "#/$defs/requestApplyPatchToolUseBlock" },
        { "$ref": "#/$defs/requestApplyPatchToolResultBlock" }
      ]
    },
    "requestTextBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/textCitation" }
        },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "requestImageBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "image" },
        "media_type": { "type": "string" },
        "data": { "type": "string" },
        "url": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["data", "media_type"],
          "not": { "required": ["url"] }
        },
        {
          "required": ["url"],
          "not": { "required": ["data"] }
        }
      ]
    },
    "requestDocumentBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "document" },
        "media_type": { "type": "string" },
        "data": { "type": "string" },
        "url": { "type": "string" },
        "file_id": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["data", "media_type"],
          "not": { "anyOf": [{ "required": ["url"] }, { "required": ["file_id"] }] }
        },
        {
          "required": ["url"],
          "not": { "anyOf": [{ "required": ["data"] }, { "required": ["file_id"] }, { "required": ["media_type"] }] }
        },
        {
          "required": ["file_id"],
          "not": { "anyOf": [{ "required": ["data"] }, { "required": ["url"] }, { "required": ["media_type"] }] }
        }
      ]
    },
    "requestToolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "string",
          "description": "Raw JSON text (INV-1); never parsed or re-serialized by converters; may be malformed in degraded cases (spec/02)."
        },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "id", "name", "input"],
      "additionalProperties": false
    },
    "requestToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/requestBlock" },
          "description": "May be empty."
        },
        "is_error": {
          "type": "boolean",
          "default": false
        },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "tool_use_id", "content"],
      "additionalProperties": false
    },
    "requestThinkingBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "thinking" },
        "thinking": { "type": "string" },
        "signature": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "thinking"],
      "additionalProperties": false
    },
    "requestRedactedThinkingBlock": {
      "type": "object",
      "description": "Anthropic encrypted thinking replay content block in request history (spec/01 s3.4, since 2.4.11).",
      "properties": {
        "type": { "const": "redacted_thinking" },
        "data": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "data"],
      "additionalProperties": false
    },
    "requestCustomToolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "custom_tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "id", "name", "input"],
      "additionalProperties": false
    },
    "requestCustomToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "custom_tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "output": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/requestTextBlock" },
                  { "$ref": "#/$defs/requestImageBlock" }
                ]
              }
            }
          ]
        },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "tool_use_id", "output"],
      "additionalProperties": false
    },
    "requestApplyPatchToolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "apply_patch_tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["in_progress", "completed"] },
        "operation": { "$ref": "#/$defs/applyPatchOperation" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "id", "status", "operation"],
      "additionalProperties": false
    },
    "requestApplyPatchToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "apply_patch_tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "failed"] },
        "output": { "type": "string" },
        "native": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAnnotation" }
        }
      },
      "required": ["type", "tool_use_id", "status"],
      "additionalProperties": false
    },
    "block": {
      "description": "Sealed union of block types, discriminated on \"type\" (spec/01 s3.4).",
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/toolUseBlock" },
        { "$ref": "#/$defs/toolResultBlock" },
        { "$ref": "#/$defs/thinkingBlock" },
        { "$ref": "#/$defs/redactedThinkingBlock" },
        { "$ref": "#/$defs/customToolUseBlock" },
        { "$ref": "#/$defs/customToolResultBlock" },
        { "$ref": "#/$defs/applyPatchToolUseBlock" },
        { "$ref": "#/$defs/applyPatchToolResultBlock" }
      ]
    },
    "applyPatchOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "create_file" }, "path": { "type": "string" }, "diff": { "type": "string" } },
          "required": ["type", "path", "diff"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "delete_file" }, "path": { "type": "string" } },
          "required": ["type", "path"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "update_file" }, "path": { "type": "string" }, "diff": { "type": "string" } },
          "required": ["type", "path", "diff"], "additionalProperties": false
        }
      ]
    },
    "applyPatchToolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "apply_patch_tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["in_progress", "completed"] },
        "operation": { "$ref": "#/$defs/applyPatchOperation" }
      },
      "required": ["type", "id", "status", "operation"], "additionalProperties": false
    },
    "applyPatchToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "apply_patch_tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "failed"] },
        "output": { "type": "string" }
      },
      "required": ["type", "tool_use_id", "status"], "additionalProperties": false
    },
    "customToolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "custom_tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "string" }
      },
      "required": ["type", "id", "name", "input"],
      "additionalProperties": false
    },
    "customToolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "custom_tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "output": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "oneOf": [
              { "$ref": "#/$defs/textBlock" },
              { "$ref": "#/$defs/imageBlock" }
            ] } }
          ]
        }
      },
      "required": ["type", "tool_use_id", "output"],
      "additionalProperties": false
    },
    "customToolInputDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "custom_tool_input_delta" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "customToolFormat": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "text" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "grammar" },
            "syntax": { "enum": ["lark", "regex"] },
            "definition": { "type": "string" }
          },
          "required": ["type", "syntax", "definition"],
          "additionalProperties": false
        }
      ]
    },
    "textBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/textCitation" }
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "textCitation": {
      "type": "object",
      "description": "Provider text citation reference (spec/01 s3.4, since 2.4.11).",
      "properties": {
        "source": { "const": "anthropic" },
        "value": { "type": "string" }
      },
      "required": ["source", "value"],
      "additionalProperties": false
    },
    "thinkingBlock": {
      "type": "object",
      "description": "Reasoning content block (spec/01 s3.4, since 2.0).",
      "properties": {
        "type": { "const": "thinking" },
        "thinking": { "type": "string" },
        "signature": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "thinking"],
      "additionalProperties": false
    },
    "redactedThinkingBlock": {
      "type": "object",
      "description": "Anthropic encrypted thinking replay content block (spec/01 s3.4, since 2.4.11).",
      "properties": {
        "type": { "const": "redacted_thinking" },
        "data": { "type": "string" }
      },
      "required": ["type", "data"],
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "description": "Image input. Exactly one of data or url MUST be present; media_type is required with data (spec/01 s3.4).",
      "properties": {
        "type": { "const": "image" },
        "media_type": {
          "type": "string",
          "pattern": "^image/.+$",
          "description": "Image MIME type, e.g. image/png."
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64",
          "description": "Base64 image data; opaque to converters."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Image URL."
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["data", "media_type"],
          "not": { "required": ["url"] }
        },
        {
          "required": ["url"],
          "not": { "required": ["data"] }
        }
      ]
    },
    "toolUseBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "string",
          "description": "Raw JSON text (INV-1); never parsed or re-serialized by converters; may be malformed in degraded cases (spec/02)."
        }
      },
      "required": ["type", "id", "name", "input"],
      "additionalProperties": false
    },
    "toolResultBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "tool_result" },
        "tool_use_id": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "May be empty."
        },
        "is_error": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["type", "tool_use_id", "content"],
      "additionalProperties": false
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "function" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "input_schema": {
              "type": "object",
              "description": "JSON-Schema-shaped object carried verbatim; never analyzed or rewritten."
            },
            "native": {
              "type": "array",
              "items": { "$ref": "#/$defs/nativeAnnotation" }
            }
          },
          "required": ["name", "input_schema"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "custom" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "format": { "$ref": "#/$defs/customToolFormat" },
            "native": {
              "type": "array",
              "items": { "$ref": "#/$defs/nativeAnnotation" }
            }
          },
          "required": ["type", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "apply_patch" },
            "native": {
              "type": "array",
              "items": { "$ref": "#/$defs/nativeAnnotation" }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "native" },
            "name": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "definition": { "type": "string", "minLength": 2, "description": "Opaque provider declaration JSON object text; identity validation follows spec/16." }
          },
          "required": ["type", "name", "source", "definition"],
          "additionalProperties": false
        }
      ]
    },
    "toolChoice": {
      "description": "Named function/custom/native choices require name; the dedicated apply_patch choice forbids name (spec/14, spec/16).",
      "oneOf": [
        {
          "type": "object",
          "properties": { "mode": { "const": "auto" } },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "mode": { "const": "any" } },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "mode": { "const": "none" } },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "tool" },
            "name": { "type": "string", "minLength": 1 },
            "tool_type": { "enum": ["function", "custom", "native"] }
          },
          "required": ["mode", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "mode": { "const": "tool" }, "tool_type": { "const": "apply_patch" } },
          "required": ["mode", "tool_type"], "additionalProperties": false
        }
      ]
    },
    "responseFormat": {
      "description": "Output formatting preference (spec/01 §3.7.1, since 2.1).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "text" }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "json_object" }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "json_schema" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "schema": {
              "type": "object",
              "description": "JSON Schema object; carried verbatim per INV-1."
            },
            "strict": { "type": "boolean" }
          },
          "required": ["type", "name", "schema"],
          "additionalProperties": false
        }
      ]
    },
    "params": {
      "type": "object",
      "description": "Sampling parameters (spec/01 s3.7); optional fields are omitted, never null. Ranges are face concerns.",
      "properties": {
        "temperature": { "type": "number" },
        "top_p": { "type": "number" },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "stop_sequences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "response_format": {
          "$ref": "#/$defs/responseFormat"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "description": "IR response document (spec/01 s4.1).",
      "properties": {
        "specVersion": {
          "enum": ["0.1.0", "0.2.0"],
          "description": "Spec version this document conforms to (document-layer field)."
        },
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "May be empty (a stream with zero blocks)."
        },
        "stop_reason": { "$ref": "#/$defs/stopReason" },
        "stop_sequence": {
          "type": "string",
          "minLength": 1,
          "description": "The matched stop sequence. MUST be absent unless stop_reason is stop_sequence; then permitted but not required (a converter may not know the matched sequence), and non-empty when present."
        },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "required": ["specVersion", "id", "model", "content", "stop_reason", "usage"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "stop_reason": { "const": "stop_sequence" } },
            "required": ["stop_reason"]
          },
          "then": true,
          "else": { "not": { "required": ["stop_sequence"] } }
        }
      ]
    },
    "stopReason": {
      "enum": [
        "end_turn",
        "max_tokens",
        "stop_sequence",
        "tool_use",
        "refusal",
        "other"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "input_tokens_details": { "$ref": "#/$defs/inputTokensDetails" },
        "output_tokens_details": { "$ref": "#/$defs/outputTokensDetails" }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "inputTokensDetails": {
      "type": "object",
      "properties": {
        "cached_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["cached_tokens"],
      "additionalProperties": false
    },
    "outputTokensDetails": {
      "type": "object",
      "properties": {
        "reasoning_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["reasoning_tokens"],
      "additionalProperties": false
    },
    "event": {
      "description": "Sealed union of the six v1 event types, discriminated on \"type\" (spec/01 s5.1).",
      "oneOf": [
        { "$ref": "#/$defs/messageStart" },
        { "$ref": "#/$defs/contentBlockStart" },
        { "$ref": "#/$defs/contentBlockDelta" },
        { "$ref": "#/$defs/contentBlockStop" },
        { "$ref": "#/$defs/messageDelta" },
        { "$ref": "#/$defs/messageDone" }
      ]
    },
    "messageStart": {
      "type": "object",
      "properties": {
        "type": { "const": "message_start" },
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "id", "model"],
      "additionalProperties": false
    },
    "contentBlockStart": {
      "type": "object",
      "properties": {
        "type": { "const": "content_block_start" },
        "index": { "type": "integer", "minimum": 0 },
        "block": { "$ref": "#/$defs/block" }
      },
      "required": ["type", "index", "block"],
      "additionalProperties": false
    },
    "contentBlockDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "content_block_delta" },
        "index": { "type": "integer", "minimum": 0 },
        "delta": { "$ref": "#/$defs/delta" }
      },
      "required": ["type", "index", "delta"],
      "additionalProperties": false
    },
    "contentBlockStop": {
      "type": "object",
      "properties": {
        "type": { "const": "content_block_stop" },
        "index": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "index"],
      "additionalProperties": false
    },
    "messageDelta": {
      "type": "object",
      "description": "Occurs exactly once, immediately before message_done (INV-5); stop_reason and usage are the final values.",
      "properties": {
        "type": { "const": "message_delta" },
        "stop_reason": { "$ref": "#/$defs/stopReason" },
        "stop_sequence": {
          "type": "string",
          "minLength": 1,
          "description": "Same conditional rule as response.stop_sequence: MUST be absent unless stop_reason is stop_sequence; then permitted but not required, and non-empty when present."
        },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "required": ["type", "stop_reason", "usage"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "stop_reason": { "const": "stop_sequence" } },
            "required": ["stop_reason"]
          },
          "then": true,
          "else": { "not": { "required": ["stop_sequence"] } }
        }
      ]
    },
    "messageDone": {
      "type": "object",
      "properties": {
        "type": { "const": "message_done" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "delta": {
      "description": "Sealed union of delta types, discriminated on \"type\" (spec/01 s5.2).",
      "oneOf": [
        { "$ref": "#/$defs/textDelta" },
        { "$ref": "#/$defs/inputJSONDelta" },
        { "$ref": "#/$defs/thinkingDelta" },
        { "$ref": "#/$defs/signatureDelta" },
        { "$ref": "#/$defs/customToolInputDelta" },
        { "$ref": "#/$defs/citationDelta" }
      ]
    },
    "citationDelta": {
      "type": "object",
      "description": "Provider text citation delta (spec/01 s5.2, since 2.4.11).",
      "properties": {
        "type": { "const": "citation_delta" },
        "citation": { "$ref": "#/$defs/textCitation" }
      },
      "required": ["type", "citation"],
      "additionalProperties": false
    },
    "textDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "text_delta" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "inputJSONDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "input_json_delta" },
        "partial_json": {
          "type": "string",
          "description": "Raw fragment of the tool-argument string (INV-1); may be empty or syntactically incomplete."
        }
      },
      "required": ["type", "partial_json"],
      "additionalProperties": false
    },
    "thinkingDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "thinking_delta" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "signatureDelta": {
      "type": "object",
      "properties": {
        "type": { "const": "signature_delta" },
        "signature": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "signature"],
      "additionalProperties": false
    },
    "eventStream": {
      "type": "object",
      "description": "JSON document form of a streamed response (spec/01 s5.3).",
      "properties": {
        "specVersion": {
          "enum": ["0.1.0", "0.2.0"],
          "description": "Spec version this document conforms to (document-layer field)."
        },
        "events": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/event" },
          "description": "Minimum valid stream: message_start, message_delta, message_done."
        }
      },
      "required": ["specVersion", "events"],
      "additionalProperties": false
    },
    "reasoningEffort": {
      "enum": ["minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "nativeAnnotation": {
      "type": "object",
      "description": "Provider-specific native request annotation preserved across IR (spec/15).",
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "omission": {
          "type": "object",
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "reason": { "enum": ["unmapped-field", "unmapped-value", "unsupported-semantic", "degraded"] },
            "detail": { "type": "string" }
          },
          "required": ["field", "reason"],
          "additionalProperties": false
        },
        "projection": {
          "type": "object",
          "properties": {
            "origin": { "enum": ["budget", "explicit"] },
            "effort": { "$ref": "#/$defs/reasoningEffort" }
          },
          "required": ["origin", "effort"],
          "additionalProperties": false
        }
      },
      "required": ["source", "kind", "value"],
      "additionalProperties": false
    }
  }
}
