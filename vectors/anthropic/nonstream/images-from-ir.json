{
  "name": "anthropic.nonstream.images-from-ir",
  "description": "IR image blocks render as Anthropic image blocks: data with media_type as a base64 source, a URL image without media_type as a url source.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "anthropic" },
  "input": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          { "type": "image", "media_type": "image/png", "data": "aGVsbG8=" },
          { "type": "image", "url": "https://example.com/cat.png" }
        ]
      }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_output": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          {
            "type": "image",
            "source": { "type": "base64", "media_type": "image/png", "data": "aGVsbG8=" }
          },
          {
            "type": "image",
            "source": { "type": "url", "url": "https://example.com/cat.png" }
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["image", "request", "n-an-5"]
}
