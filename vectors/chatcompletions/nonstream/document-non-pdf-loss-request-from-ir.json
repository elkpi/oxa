{
  "name": "chatcompletions.nonstream.document-non-pdf-loss-request-from-ir",
  "description": "IR DocumentBlock with non-PDF media type reports unsupported-semantic loss when encoding to Chat Completions (N-CC-14).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "document", "media_type": "text/plain", "data": "SGVsbG8=" },
          { "type": "text", "text": "Analyze." }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Analyze."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0]",
      "field": "content",
      "reason": "unsupported-semantic",
      "detail": "Chat Completions file content parts do not support non-PDF media types; file dropped"
    }
  ],
  "tags": ["document", "request", "N-CC-14", "loss"]
}
