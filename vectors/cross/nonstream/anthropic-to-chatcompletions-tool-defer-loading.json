{
  "name": "cross.nonstream.anthropic-to-chatcompletions-tool-defer-loading",
  "description": "Anthropic tool with defer_loading degrades to eagerly declared Chat Completions tool with degraded loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Call tool."
      }
    ],
    "tools": [
      {
        "name": "lookup",
        "description": "Search DB.",
        "input_schema": {
          "type": "object"
        },
        "defer_loading": true
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": "Call tool."
      }
    ],
    "max_tokens": 16000,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup",
          "description": "Search DB.",
          "parameters": {
            "type": "object"
          }
        }
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tools[0].native[0]",
      "field": "defer_loading",
      "reason": "degraded",
      "detail": "deferred tool loading is a provider-side context-assembly instruction; the tool definition is unchanged and loads up front when the target has no tool search"
    }
  ],
  "tags": [
    "cross",
    "request",
    "native",
    "tools",
    "defer-loading",
    "loss"
  ]
}
