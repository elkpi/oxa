{
  "name": "chatcompletions.nonstream.multiturn-request-to-ir",
  "description": "A user/assistant/user Chat Completions conversation maps to three IR messages with text blocks.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "user", "content": "What is 2+2?" },
      { "role": "assistant", "content": "4" },
      { "role": "user", "content": "And 3+3?" }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is 2+2?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "4" }] },
      { "role": "user", "content": [{ "type": "text", "text": "And 3+3?" }] }
    ]
  },
  "expected_losses": [],
  "tags": ["multiturn", "request"]
}
