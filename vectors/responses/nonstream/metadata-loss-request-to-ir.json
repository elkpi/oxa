{
  "name": "responses.nonstream.metadata-loss-request-to-ir",
  "description": "Responses request metadata is preserved in Request.Metadata. The historical whole-map loss no longer applies.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "model": "gpt-4o-mini",
    "metadata": { "user_id": "u1" },
    "input": "Hi"
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o-mini",
    "metadata": { "user_id": "u1" },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_losses": [],
  "tags": ["request", "metadata"]
}
