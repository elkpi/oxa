{
  "name": "responses.nonstream.web-search-call-request-to-ir",
  "description": "A completed web_search_call joins the following assistant message and is preserved with its search action (N-R-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {"protocol": "responses"},
  "input": {
    "model": "gpt-5",
    "max_output_tokens": 64,
    "input": [
      {"type": "web_search_call", "id": "ws_1", "status": "completed", "action": {"type": "search", "query": "latest AI news"}},
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "Earlier answer"}]},
      {"type": "message", "role": "user", "content": "Continue"}
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-5",
    "messages": [
      {"role": "assistant", "content": [
        {"type": "text", "text": "Earlier answer"},
        {"type": "web_search_call", "id": "ws_1", "status": "completed", "action": {"type": "search", "query": "latest AI news"}}
      ]},
      {"role": "user", "content": [{"type": "text", "text": "Continue"}]}
    ],
    "params": {"max_tokens": 64}
  },
  "expected_losses": [],
  "tags": ["request", "web-search", "n-r-16"]
}
