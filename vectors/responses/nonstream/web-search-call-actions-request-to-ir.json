{
  "name": "responses.nonstream.web-search-call-actions-request-to-ir",
  "description": "search, open_page, and find_in_page actions stay in encounter order after the user turn (N-R-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {"protocol": "responses"},
  "input": {
    "model": "gpt-5",
    "input": [
      {"role": "user", "content": "Look this up"},
      {"type": "web_search_call", "id": "ws_search", "status": "completed", "action": {"type": "search", "queries": ["one", "two"]}},
      {"type": "web_search_call", "id": "ws_open", "status": "completed", "action": {"type": "open_page", "url": "https://example.com"}},
      {"type": "web_search_call", "id": "ws_find", "status": "in_progress", "action": {"type": "find_in_page", "url": "https://example.com/a", "pattern": "token"}}
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-5",
    "messages": [
      {"role": "user", "content": [{"type": "text", "text": "Look this up"}]},
      {"role": "assistant", "content": [
        {"type": "web_search_call", "id": "ws_search", "status": "completed", "action": {"type": "search", "queries": ["one", "two"]}},
        {"type": "web_search_call", "id": "ws_open", "status": "completed", "action": {"type": "open_page", "url": "https://example.com"}},
        {"type": "web_search_call", "id": "ws_find", "status": "in_progress", "action": {"type": "find_in_page", "url": "https://example.com/a", "pattern": "token"}}
      ]}
    ]
  },
  "expected_losses": [],
  "tags": ["request", "web-search", "n-r-16"]
}
