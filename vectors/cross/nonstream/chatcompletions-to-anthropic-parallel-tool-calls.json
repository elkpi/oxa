{
  "name": "cross.nonstream.chatcompletions-to-anthropic-parallel-tool-calls",
  "description": "Cross encoding from Chat Completions to Anthropic: parallel_tool_calls false maps to tool_choice disable_parallel_tool_use true with zero loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
        }
      }
    ],
    "tool_choice": "auto",
    "parallel_tool_calls": false
  },
  "expected_output": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": {
      "type": "auto",
      "disable_parallel_tool_use": true
    }
  },
  "expected_losses": [],
  "tags": ["cross", "request", "chatcompletions", "anthropic", "parallel-tools"]
}
