{
  "name": "cross.nonstream.responses-to-chatcompletions-thinking-response",
  "description": "Cross-protocol: Responses reasoning item converts to Chat Completions with reasoning_content, preserving text and reasoning losslessly (N-R-13, N-CC-12).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "id": "resp_think_cc_cross",
    "object": "response",
    "status": "completed",
    "model": "o3-mini",
    "output": [
      {
        "type": "reasoning",
        "id": "rs_c1",
        "summary": [{ "type": "output_text", "text": "Step-by-step logic.", "annotations": [] }]
      },
      {
        "type": "message",
        "id": "msg_c1",
        "role": "assistant",
        "status": "completed",
        "content": [{ "type": "output_text", "text": "Result 42.", "annotations": [] }]
      }
    ],
    "usage": { "input_tokens": 8, "output_tokens": 16, "total_tokens": 24 }
  },
  "expected_output": {
    "id": "resp_think_cc_cross",
    "object": "chat.completion",
    "created": 0,
    "model": "o3-mini",
    "choices": [
      {
        "index": 0,
        "message": {
          "role": "assistant",
          "content": "Result 42.",
          "reasoning_content": "Step-by-step logic."
        },
        "finish_reason": "stop"
      }
    ],
    "usage": { "prompt_tokens": 8, "completion_tokens": 16, "total_tokens": 24 }
  },
  "expected_losses": [],
  "tags": ["cross", "thinking", "response", "n-r-13", "n-cc-12"]
}
