{
  "name": "anthropic.nonstream.tools-definition-to-ir",
  "description": "Anthropic tool definitions with JSON Schema input_schema objects map to IR tools with the schema bytes carried verbatim.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Book a table" }],
    "tools": [
      {
        "name": "reserve_table",
        "description": "Reserve a dinner table.",
        "input_schema": {
          "type": "object",
          "properties": {
            "party_size": { "type": "integer", "minimum": 1 },
            "date": { "type": "string", "description": "ISO date" }
          },
          "required": ["date"]
        }
      },
      { "name": "list_menu", "input_schema": { "type": "object" } }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "Book a table" }] }],
    "tools": [
      {
        "name": "reserve_table",
        "description": "Reserve a dinner table.",
        "input_schema": {
          "type": "object",
          "properties": {
            "party_size": { "type": "integer", "minimum": 1 },
            "date": { "type": "string", "description": "ISO date" }
          },
          "required": ["date"]
        }
      },
      { "name": "list_menu", "input_schema": { "type": "object" } }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_losses": [],
  "tags": ["tools", "request", "inv-1"]
}
