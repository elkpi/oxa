{
  "name": "cross.nonstream.chatcompletions-to-anthropic-json-schema-request",
  "description": "OpenAI schema maps to Anthropic with explicit losses for its outer envelope.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "chatcompletions"},
  "target": {"protocol": "anthropic"},
  "input": {"model": "m", "max_tokens": 64, "messages": [{"role": "user", "content": "hi"}], "response_format": {"type": "json_schema", "json_schema": {"name": "result", "description": "result schema", "schema": {"type": "object"}, "strict": false}}},
  "expected_output": {"model": "m", "max_tokens": 64, "messages": [{"role": "user", "content": "hi"}], "output_config": {"format": {"type": "json_schema", "schema": {"type": "object"}}}},
  "expected_losses": [
    {"path": "params.response_format.name", "field": "name", "reason": "unmapped-field"},
    {"path": "params.response_format.description", "field": "description", "reason": "unmapped-field"},
    {"path": "params.response_format.strict", "field": "strict", "reason": "unmapped-field"}
  ],
  "tags": ["cross", "request", "format", "loss"]
}
