{
  "name": "cross.nonstream.anthropic-to-responses-tool-reference-cache",
  "description": "Cross-protocol: a tool_reference with an attached cache_control breakpoint crossing to Responses reports exactly one whole-block unsupported-semantic loss; the annotation is part of the dropped block and is not reported again (N-AN-21, spec/15 s4).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "responses" },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "tools": [
      {
        "name": "get_weather",
        "description": "Get weather",
        "input_schema": {
          "type": "object"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "What is the weather?"
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "call_1",
            "name": "tool_search",
            "input": {"query":"weather"}
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "call_1",
            "content": [
              {
                "type": "tool_reference",
                "tool_name": "get_weather",
                "cache_control": {
                  "type": "ephemeral"
                }
              },
              {
                "type": "text",
                "text": "Found 1 matching tool"
              }
            ]
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_output_tokens": 1024,
    "tools": [
      {
        "type": "function",
        "name": "get_weather",
        "description": "Get weather",
        "parameters": {
          "type": "object"
        }
      }
    ],
    "input": [
      {
        "role": "user",
        "content": "What is the weather?"
      },
      {
        "type": "function_call",
        "call_id": "call_1",
        "name": "tool_search",
        "arguments": "{\"query\":\"weather\"}"
      },
      {
        "type": "function_call_output",
        "call_id": "call_1",
        "output": "Found 1 matching tool"
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[2].content[0].content[0]",
      "field": "content",
      "reason": "unsupported-semantic"
    }
  ],
  "tags": ["cross", "tools", "tool_reference", "request", "n-an-21"]
}
