{
  "name": "chatcompletions.nonstream.document-file-id-request-to-ir",
  "description": "Chat Completions request file content part with file_id maps to IR DocumentBlock with file_id (N-CC-14).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "file", "file": { "file_id": "file_123" } },
          { "type": "text", "text": "Read the file." }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "document", "file_id": "file_123" },
          { "type": "text", "text": "Read the file." }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["document", "request", "N-CC-14"]
}
