{
  "name": "cross.nonstream.responses-to-chatcompletions-additional-tools-request",
  "description": "Cross-protocol: Responses input additional_tools items cannot be represented on Chat Completions and record unsupported-semantic loss (N-CC-17).",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "responses"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "gpt-5.5",
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": "Use additional tool."
      },
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": [
          {
            "type": "function",
            "name": "calc",
            "description": "Calculator",
            "parameters": {
              "type": "object"
            },
            "strict": true
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": "Use additional tool."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tool_change_groups[0].parts[0]",
      "field": "op",
      "reason": "unsupported-semantic",
      "detail": "positional tool availability change cannot be represented on the target face"
    }
  ],
  "tags": [
    "cross",
    "tools",
    "request",
    "additional_tools",
    "N-R-15"
  ]
}
