{
  "name": "chatcompletions.nonstream.images-from-ir",
  "description": "IR images render as Chat Completions content parts: base64 data as a data:image PNG URL and a URL image as its https URL; mixed text and image content renders as a parts array.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          { "type": "image", "media_type": "image/png", "data": "aGVsbG8=" },
          { "type": "image", "url": "https://example.com/cat.png" }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          { "type": "image_url", "image_url": { "url": "data:image/png;base64,aGVsbG8=" } },
          { "type": "image_url", "image_url": { "url": "https://example.com/cat.png" } }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["image", "request", "n-cc-2", "n-cc-3"]
}
