{
  "name": "anthropic.nonstream.tool-choice-any-to-ir",
  "description": "Anthropic tool_choice {type:any} maps to IR tool-choice mode any, the same IR mode as Chat Completions tool_choice required.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": { "type": "any" }
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "Weather in Paris?" }] }],
    "tools": [
      {
        "name": "get_weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": { "mode": "any" },
    "params": { "max_tokens": 1024 }
  },
  "expected_losses": [],
  "tags": ["tools", "request", "tool-choice", "n-an-6"]
}
