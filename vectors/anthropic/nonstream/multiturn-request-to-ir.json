{
  "name": "anthropic.nonstream.multiturn-request-to-ir",
  "description": "A user/assistant/user Anthropic conversation with block content maps to three IR messages.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is 2+2?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "4" }] },
      { "role": "user", "content": [{ "type": "text", "text": "And 3+3?" }] }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "What is 2+2?" }] },
      { "role": "assistant", "content": [{ "type": "text", "text": "4" }] },
      { "role": "user", "content": [{ "type": "text", "text": "And 3+3?" }] }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_losses": [],
  "tags": ["multiturn", "request"]
}
