{
  "name": "chatcompletions.stream.unknown-event-field-to-ir",
  "description": "A present unknown property on a recognized Chat Completions chunk is lost without changing the valid stream lifecycle.",
  "spec_version": "0.1.0",
  "mode": "stream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "events": [
      {
        "id": "chatcmpl_unknown",
        "object": "chat.completion.chunk",
        "created": 0,
        "model": "gpt-4o-mini",
        "choices": [{ "index": 0, "delta": { "role": "assistant" }, "finish_reason": null }],
        "unknown_extension": null
      },
      {
        "id": "chatcmpl_unknown",
        "object": "chat.completion.chunk",
        "created": 0,
        "model": "gpt-4o-mini",
        "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }],
        "usage": { "prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0 }
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "events": [
      { "type": "message_start", "id": "chatcmpl_unknown", "model": "gpt-4o-mini" },
      { "type": "message_delta", "stop_reason": "end_turn", "usage": { "input_tokens": 0, "output_tokens": 0 } },
      { "type": "message_done" }
    ]
  },
  "expected_losses": [
    { "path": "unknown_extension", "field": "unknown_extension", "reason": "unmapped-field" }
  ],
  "tags": ["stream", "loss", "unknown-field"]
}
