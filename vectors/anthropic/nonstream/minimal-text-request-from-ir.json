{
  "name": "anthropic.nonstream.minimal-text-request-from-ir",
  "description": "Minimal IR request renders as an Anthropic Messages request with required max_tokens.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "anthropic" },
  "input": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hello" }] }
    ],
    "params": { "max_tokens": 1024 }
  },
  "expected_output": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Hello" }]
  },
  "expected_losses": [],
  "tags": ["text", "request", "minimal"]
}
