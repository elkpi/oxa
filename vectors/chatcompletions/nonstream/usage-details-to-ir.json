{
  "name": "chatcompletions.nonstream.usage-details-to-ir",
  "description": "Chat Completions prompt_tokens_details and completion_tokens_details map to IR usage details (spec/01 s4.2).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "id": "chatcmpl-details",
    "object": "chat.completion",
    "created": 1720000000,
    "model": "o3-mini",
    "choices": [
      {
        "index": 0,
        "message": { "role": "assistant", "content": "Detailed response." },
        "finish_reason": "stop"
      }
    ],
    "usage": {
      "prompt_tokens": 50,
      "completion_tokens": 25,
      "total_tokens": 75,
      "prompt_tokens_details": { "cached_tokens": 40 },
      "completion_tokens_details": { "reasoning_tokens": 15 }
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "id": "chatcmpl-details",
    "model": "o3-mini",
    "content": [{ "type": "text", "text": "Detailed response." }],
    "stop_reason": "end_turn",
    "usage": {
      "input_tokens": 50,
      "output_tokens": 25,
      "input_tokens_details": { "cached_tokens": 40 },
      "output_tokens_details": { "reasoning_tokens": 15 }
    }
  },
  "expected_losses": [],
  "tags": ["response", "usage", "details"]
}
