{
  "name": "anthropic.nonstream.system-prompt-request-to-ir",
  "description": "An Anthropic system prompt (block array) becomes the IR system block list.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 512,
    "system": [{ "type": "text", "text": "You are a terse assistant." }],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "claude-sonnet-4-5",
    "system": [{ "type": "text", "text": "You are a terse assistant." }],
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ],
    "params": { "max_tokens": 512 }
  },
  "expected_losses": [],
  "tags": ["system", "request"]
}
