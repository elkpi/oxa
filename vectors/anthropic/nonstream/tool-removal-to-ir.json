{
  "name": "anthropic.nonstream.tool-removal-to-ir",
  "description": "Anthropic mid-conversation system message containing tool_removal decodes into tool_change_groups (N-AN-22).",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-3-5-sonnet-20241022",
    "max_tokens": 1024,
    "tools": [
      {
        "name": "old_tool",
        "input_schema": {
          "type": "object"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "Retire tool"
      },
      {
        "role": "system",
