{
  "name": "cross.nonstream.responses-to-anthropic-additional-tools-request",
  "description": "Cross-protocol: Responses input additional_tools items convert to Anthropic mid-conversation system tool_addition (N-AN-22).",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "responses"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "gpt-5.5",
    "max_output_tokens": 1024,
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": "Use additional tool."
      },
      {
        "type": "additional_tools",
        "role": "developer",
        "tools": [
          {
            "type": "function",
            "name": "calc",
            "description": "Calculator",
            "parameters": {
              "type": "object"
            },
            "strict": true
          }
        ],
        "future": {
          "sensitive": "do-not-report"
        }
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5.5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Use additional tool."
      },
      {
        "role": "system",
        "content": [
          {
            "type": "tool_addition",
            "tool": {
              "type": "tool_definition",
              "definition": {
                "name": "calc",
                "description": "Calculator",
                "input_schema": {
                  "type": "object"
                },
                "strict": true
              }
            }
          }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tool_change_groups[0].extra",
      "field": "extra",
      "reason": "unmapped-field",
      "detail": "additional_tools item extensions have no equivalent on the target face"
    }
  ],
  "tags": [
    "cross",
    "tools",
    "request",
    "additional_tools",
    "N-R-15"
  ]
}
