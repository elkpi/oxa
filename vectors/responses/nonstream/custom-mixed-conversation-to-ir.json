{
  "name": "responses.nonstream.custom-mixed-conversation-to-ir",
  "description": "N-C-1 至 N-C-4：Custom Tools 显式类型、任意文本保真与调用关联。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "responses"
  },
  "input": {
    "model": "m",
    "input": [
      {
        "role": "user",
        "content": "go"
      },
      {
        "type": "custom_tool_call",
        "call_id": "call_custom",
        "name": "code_exec",
        "input": "print(\"你好\\world\")\r\nnot JSON\t\u0000"
      },
      {
        "type": "function_call",
        "call_id": "call_function",
        "name": "clock",
        "arguments": "{\"tz\": \"UTC\"}"
      },
      {
        "type": "custom_tool_call_output",
        "call_id": "call_custom",
        "output": [
          {
            "type": "input_text",
            "text": "你好"
          },
          {
            "type": "input_image",
            "image_url": "https://example.com/result.png"
          }
        ]
      },
      {
        "type": "function_call_output",
        "call_id": "call_function",
        "output": "UTC"
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "custom-tools",
    "n-c-1",
    "n-c-2",
    "n-c-3",
    "n-c-4"
  ],
  "provenance": {
    "doc_url": "https://github.com/openai/openai-python/tree/e71d781ac5e7b3f365ac130bf338baaf13ae720d/src/openai/types/responses",
    "retrieved": "2026-10-16"
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "m",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "go"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "custom_tool_use",
            "id": "call_custom",
            "name": "code_exec",
            "input": "print(\"你好\\world\")\r\nnot JSON\t\u0000"
          },
          {
            "type": "tool_use",
            "id": "call_function",
            "name": "clock",
            "input": "{\"tz\": \"UTC\"}"
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "custom_tool_result",
            "tool_use_id": "call_custom",
            "output": [
              {
                "type": "text",
                "text": "你好"
              },
              {
                "type": "image",
                "url": "https://example.com/result.png"
              }
            ]
          },
          {
            "type": "tool_result",
            "tool_use_id": "call_function",
            "content": [
              {
                "type": "text",
                "text": "UTC"
              }
            ]
          }
        ]
      }
    ]
  }
}
