{
  "name": "@elkpi/oxa",
  "version": "0.1.0",
  "description": "Pure in-process protocol conversion for OpenAI and Anthropic APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "generate": "node scripts/generate-schema-types.mjs",
    "generate:check": "node scripts/generate-schema-types.mjs --check",
    "test": "npm run build:test && node scripts/run-tests.mjs",
    "test:architecture": "npm run build:test && node --test dist-test/test/architecture.test.js",
    "test:node": "npm test",
    "test:web": "tsc -p tsconfig.web.json && node scripts/test-web-runtime.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run check",
    "fmt": "prettier . --check"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  }
}
