{
  "name": "responses.nonstream.tool-additional-tools-transparent-runs-to-ir",
  "description": "Empty additional_tools items do not split assistant calls, tool results, or apply_patch pairing, and are preserved as empty groups without loss.",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "responses"
  },
