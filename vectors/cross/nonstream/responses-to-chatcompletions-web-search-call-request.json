{
  "name": "cross.nonstream.responses-to-chatcompletions-web-search-call-request",
  "description": "A Responses web_search_call is omitted on Chat Completions with one target-side loss and is not rewritten as a function call (N-R-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "responses"},
  "target": {"protocol": "chatcompletions"},
  "input": {
    "model": "gpt-5",
    "max_output_tokens": 64,
    "input": [
      {"role": "user", "content": "hi"},
      {"type": "web_search_call", "id": "ws_1", "status": "completed", "action": {"type": "search", "query": "news"}},
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "Earlier answer"}]},
      {"type": "message", "role": "user", "content": "Continue"}
    ]
  },
  "expected_output": {
    "model": "gpt-5",
    "max_tokens": 64,
    "messages": [
      {"role": "user", "content": "hi"},
      {"role": "assistant", "content": "Earlier answer"},
      {"role": "user", "content": "Continue"}
    ]
  },
  "expected_losses": [
    {"path": "messages[1].content[1]", "field": "type", "reason": "unsupported-semantic"}
  ],
  "tags": ["cross", "request", "web-search", "loss", "n-r-16"]
}
