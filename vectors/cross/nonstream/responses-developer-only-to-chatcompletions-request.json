{
  "name": "cross.nonstream.responses-developer-only-to-chatcompletions-request",
  "description": "A sole developer message survives conversion to Chat as system content plus an explicitly degraded empty user turn.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "responses"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "m",
    "input": [
      {
        "role": "developer",
        "content": "Answer briefly."
      }
    ]
  },
  "expected_output": {
    "model": "m",
    "messages": [
      {
        "role": "developer",
        "content": "Answer briefly."
      },
      {
        "role": "user",
        "content": ""
      }
    ]
  },
  "expected_losses": [
    {
      "path": "input",
      "field": "input",
      "reason": "degraded"
    }
  ],
  "tags": [
    "cross",
    "developer",
    "system",
    "request",
    "loss",
    "N-R-1"
  ]
}
