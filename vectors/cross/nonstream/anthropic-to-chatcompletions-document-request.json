{
  "name": "cross.nonstream.anthropic-to-chatcompletions-document-request",
  "description": "Cross-protocol: an Anthropic document block converts to Chat Completions as exactly one whole-block unsupported-semantic loss; annotations inside the dropped block add no further losses (N-AN-16), and the sibling text survives as string content.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "document",
            "source": {
              "type": "base64",
              "media_type": "application/pdf",
              "data": "JVBERi0xLjcK"
            },
            "title": "Q3 Report",
            "context": "financial filing",
            "citations": {
              "enabled": true
            },
            "cache_control": {
              "type": "ephemeral"
            }
          },
          {
            "type": "text",
            "text": "Summarize the documents."
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Summarize the documents."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0]",
      "field": "content",
      "reason": "unsupported-semantic",
      "detail": "IR ir.DocumentBlock cannot be rendered in a Chat Completions user message"
    }
  ],
  "tags": [
    "cross",
    "document",
    "request",
    "n-an-16"
  ]
}
