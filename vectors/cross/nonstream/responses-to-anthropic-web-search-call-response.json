{
  "name": "cross.nonstream.responses-to-anthropic-web-search-call-response",
  "description": "Cross-protocol: Responses response with web_search_call item converts to Anthropic with unsupported-semantic loss, preserving message content (N-R-16).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "anthropic" },
  "input": {
    "id": "resp_ws_ant_cross",
    "object": "response",
    "status": "completed",
    "model": "gpt-5",
    "output": [
      {
        "type": "web_search_call",
        "id": "ws_1",
        "status": "completed",
        "action": { "type": "search", "query": "news" }
      },
      {
        "type": "message",
        "role": "assistant",
        "status": "completed",
        "content": [{ "type": "output_text", "text": "Here are the news.", "annotations": [] }]
      }
    ],
    "usage": { "input_tokens": 5, "output_tokens": 10, "total_tokens": 15 }
  },
  "expected_output": {
    "id": "resp_ws_ant_cross",
    "type": "message",
    "role": "assistant",
    "model": "gpt-5",
    "content": [
      { "type": "text", "text": "Here are the news." }
    ],
    "stop_reason": "end_turn",
    "usage": { "input_tokens": 5, "output_tokens": 10 }
  },
  "expected_losses": [
    {
      "path": "content[1]",
      "field": "type",
      "reason": "unsupported-semantic"
    }
  ],
  "tags": ["cross", "response", "web-search", "loss", "n-r-16"]
}
