{
  "name": "chatcompletions.nonstream.request-controls-from-ir",
  "description": "IR request with OpenAI store, stream, stream_options native annotations encodes back to Chat Completions.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "chatcompletions"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "specVersion": "0.2.0",
    "model": "gpt-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ],
    "native": [
      {
        "source": "openai",
        "kind": "store",
        "value": "false"
      },
      {
        "source": "openai",
        "kind": "stream",
        "value": "true"
      },
      {
        "source": "openai",
        "kind": "stream_options",
        "value": "{\"include_usage\":true}"
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "store": false,
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "expected_losses": [],
  "tags": [
    "request",
    "chatcompletions",
    "controls",
    "native"
  ]
}
