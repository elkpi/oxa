{
  "name": "chatcompletions.nonstream.document-filename-loss-request-to-ir",
  "description": "Chat Completions request file part with file.filename reports an unmapped-field loss (N-CC-14).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "file",
            "file": {
              "file_id": "file_123",
              "filename": "paper.pdf"
            }
          }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "document", "file_id": "file_123" }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0].file.filename",
      "field": "filename",
      "reason": "unmapped-field",
      "detail": "Chat Completions file filename has no IR equivalent"
    }
  ],
  "tags": ["document", "request", "N-CC-14", "loss"]
}
