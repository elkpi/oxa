{
  "name": "cross.nonstream.responses-to-anthropic-parallel-tool-calls",
  "description": "Cross encoding from Responses to Anthropic: parallel_tool_calls false maps to tool_choice disable_parallel_tool_use true with zero loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "claude-3-5-sonnet",
    "max_output_tokens": 1024,
    "input": "Weather in Paris?",
    "tools": [
      {
        "type": "function",
        "name": "get_weather",
        "description": "Fetch weather",
        "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": "auto",
    "parallel_tool_calls": false
  },
  "expected_output": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "name": "get_weather",
        "description": "Fetch weather",
        "input_schema": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": {
      "type": "auto",
      "disable_parallel_tool_use": true
    }
  },
  "expected_losses": [],
  "tags": ["cross", "request", "responses", "anthropic", "parallel-tools"]
}
