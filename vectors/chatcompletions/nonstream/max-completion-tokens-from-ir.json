{
  "name": "chatcompletions.nonstream.max-completion-tokens-from-ir",
  "description": "IR request with max_completion_tokens native annotation encodes to wire max_completion_tokens.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "chatcompletions"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "specVersion": "0.2.0",
    "model": "gpt-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 1024
    },
    "native": [
      {
        "source": "openai",
        "kind": "max_completion_tokens",
        "value": "true"
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "max_completion_tokens": 1024
  },
  "expected_losses": [],
  "tags": [
    "params",
    "request",
    "chatcompletions",
    "native"
  ]
}
