{
  "name": "responses.nonstream.instructions-only-request-to-ir",
  "description": "Instruction-only requests use an explicitly degraded empty user turn without changing the IR schema.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": { "model": "m", "instructions": "", "input": [] },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "m",
    "system": [{ "type": "text", "text": "" }],
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "" }] }]
  },
  "expected_losses": [{ "path": "input", "field": "input", "reason": "degraded" }],
  "tags": ["system", "request", "loss", "N-R-1"]
}
