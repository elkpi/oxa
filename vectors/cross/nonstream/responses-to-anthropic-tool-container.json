{
  "name": "cross.nonstream.responses-to-anthropic-tool-container",
  "description": "Cross-protocol: Responses tool container converts to Anthropic Messages as a flattened dotted tool with degraded loss (N-R-15).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "responses" },
  "target": { "protocol": "anthropic" },
  "input": {
    "model": "gpt-5.5",
    "max_output_tokens": 1024,
    "input": "Edit code.",
    "tools": [
      {
        "type": "namespace",
        "name": "editor",
        "description": "Editor tools",
        "tools": [
          {
            "type": "function",
            "name": "submit_patch",
            "description": "Submit a patch",
            "parameters": {
              "type": "object",
              "properties": { "diff": { "type": "string" } },
              "required": ["diff"]
            },
            "strict": true
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "gpt-5.5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": "Edit code."
      }
    ],
    "tools": [
      {
        "name": "editor.submit_patch",
        "description": "Submit a patch",
        "input_schema": {
          "type": "object",
          "properties": { "diff": { "type": "string" } },
          "required": ["diff"]
        },
        "strict": true
      }
    ]
  },
  "expected_losses": [
    {
      "path": "tools[0].native[0]",
      "field": "type",
      "reason": "degraded",
      "detail": "tool container grouping was flattened into dotted tool names"
    }
  ],
  "tags": ["cross", "request", "container", "namespace", "N-R-15"]
}
