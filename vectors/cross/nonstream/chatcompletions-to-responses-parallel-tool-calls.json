{
  "name": "cross.nonstream.chatcompletions-to-responses-parallel-tool-calls",
  "description": "Cross encoding from Chat Completions to Responses: parallel_tool_calls false maps loss-free.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "responses" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [{ "role": "user", "content": "Weather in Paris?" }],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Fetch weather",
          "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
        }
      }
    ],
    "tool_choice": "auto",
    "parallel_tool_calls": false
  },
  "expected_output": {
    "model": "gpt-4o-mini",
    "input": "Weather in Paris?",
    "tools": [
      {
        "type": "function",
        "name": "get_weather",
        "description": "Fetch weather",
        "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
      }
    ],
    "tool_choice": "auto",
    "parallel_tool_calls": false
  },
  "expected_losses": [],
  "tags": ["cross", "request", "chatcompletions", "responses", "parallel-tools"]
}
