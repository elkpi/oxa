{
  "name": "cross.nonstream.responses-to-chatcompletions-custom-tool",
  "description": "Cross-protocol: OpenAI Responses 自定义工具请求通过 IR 转换为 OpenAI Chat Completions 原生嵌套自定义工具请求，零 loss。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "responses"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "m",
    "tools": [
      {
        "type": "custom",
        "name": "code_exec",
        "description": "Executes text verbatim.",
        "format": {
          "type": "text"
        }
      }
    ],
    "tool_choice": {
      "type": "custom",
      "name": "code_exec"
    },
    "input": [
      {
        "role": "user",
        "content": "run code"
      },
      {
        "type": "custom_tool_call",
        "call_id": "call_c",
        "name": "code_exec",
        "input": "print(\"hello\")"
      },
      {
        "type": "custom_tool_call_output",
        "call_id": "call_c",
        "output": "hello"
      }
    ]
  },
  "expected_output": {
    "model": "m",
    "tools": [
      {
        "type": "custom",
        "custom": {
          "name": "code_exec",
          "description": "Executes text verbatim.",
          "format": {
            "type": "text"
          }
        }
      }
    ],
    "tool_choice": {
      "type": "custom",
      "custom": {
        "name": "code_exec"
      }
    },
    "messages": [
      {
        "role": "user",
        "content": "run code"
      },
      {
        "role": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "call_c",
            "type": "custom",
            "custom": {
              "name": "code_exec",
              "input": "print(\"hello\")"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_c",
        "content": "hello"
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "cross",
    "custom-tools",
    "request",
    "n-cc-14"
  ]
}
