{
  "name": "cross.nonstream.anthropic-to-anthropic-native-tools",
  "description": "Anthropic 原生声明与普通工具混合时，同协议保留配置和 named choice。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "m",
    "max_tokens": 32,
    "tools": [
      {
        "name": "lookup",
        "input_schema": {
          "type": "object"
        }
      },
      { "type" : "advisor_20260301", "name" : "advisor", "model" : "opus", "max_uses" : 2, "cache_control" : {"type":"ephemeral"}, "vendor_config" : {"budget":1e+03,"enabled":true} },
      {"type":"future_20990101","name":"future","config":{"opaque":[1,true,{"x":"y"}]}}
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "tool_choice": {
      "type": "tool",
      "name": "advisor"
    }
  },
  "expected_output": {
    "model": "m",
    "max_tokens": 32,
    "tools": [
      {
        "name": "lookup",
        "input_schema": {
          "type": "object"
        }
      },
      { "type" : "advisor_20260301", "name" : "advisor", "model" : "opus", "max_uses" : 2, "cache_control" : {"type":"ephemeral"}, "vendor_config" : {"budget":1e+03,"enabled":true} },
      {"type":"future_20990101","name":"future","config":{"opaque":[1,true,{"x":"y"}]}}
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "tool_choice": {
      "type": "tool",
      "name": "advisor"
    }
  },
  "expected_losses": [],
  "tags": [
    "request",
    "tools",
    "native",
    "n-nt-1",
    "n-nt-2",
    "n-nt-3",
    "n-nt-4"
  ]
}
