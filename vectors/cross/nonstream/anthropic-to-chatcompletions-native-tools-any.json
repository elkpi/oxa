{
  "name": "cross.nonstream.anthropic-to-chatcompletions-native-tools-any",
  "description": "全部原生声明丢弃后，省略 any choice 并报告损失。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "m",
    "max_tokens": 32,
    "tools": [
      {"type":"advisor_20260301","name":"advisor","model":"opus"}
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "tool_choice": {
      "type": "any"
    }
  },
  "expected_output": {
    "model": "m",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "max_tokens": 32
  },
  "expected_losses": [
    {
      "path": "tools[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "native tool \"advisor\" from \"anthropic\" cannot be represented by the target protocol"
    },
    {
      "path": "tool_choice",
      "field": "tool_choice",
      "reason": "unsupported-semantic",
      "detail": "all tool declarations were dropped"
    }
  ],
  "tags": [
    "request",
    "tools",
    "native",
    "n-nt-1",
    "n-nt-2",
    "n-nt-3",
    "n-nt-4"
  ]
}
