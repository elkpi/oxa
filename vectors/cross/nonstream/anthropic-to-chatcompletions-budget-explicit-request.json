{
  "name": "cross.nonstream.anthropic-to-chatcompletions-budget-explicit-request",
  "description": "Cross-protocol: Anthropic request with enabled budget 2048 and explicit effort high maps to Chat Completions high effort with unmapped-field losses for type and budget_tokens.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "claude-3-7-sonnet-20250219",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Solve."
      }
    ],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 2048
    },
    "output_config": {
      "effort": "high"
    }
  },
  "expected_output": {
    "model": "claude-3-7-sonnet-20250219",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Solve."
      }
    ],
    "reasoning_effort": "high"
  },
  "expected_losses": [
    {
      "path": "native[0]",
      "field": "type",
      "reason": "unmapped-field"
    },
    {
      "path": "native[1]",
      "field": "budget_tokens",
      "reason": "unmapped-field"
    }
  ],
  "tags": [
    "cross",
    "request",
    "thinking",
    "budget",
    "effort",
    "loss"
  ]
}
