{
  "name": "chatcompletions.nonstream.params-request-from-ir",
  "description": "IR params render as Chat Completions temperature, top_p, max_tokens and stop.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hello" }] }
    ],
    "params": {
      "temperature": 0.5,
      "top_p": 0.9,
      "max_tokens": 256,
      "stop_sequences": ["\n\n", "END"]
    }
  },
  "expected_output": {
    "model": "gpt-4o-mini",
    "messages": [{ "role": "user", "content": "Hello" }],
    "temperature": 0.5,
    "top_p": 0.9,
    "max_tokens": 256,
    "stop": ["\n\n", "END"]
  },
  "expected_losses": [],
  "tags": ["params", "request"]
}
