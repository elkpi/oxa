{
  "name": "cross.nonstream.anthropic-to-chatcompletions-tool-reference-toplevel",
  "description": "Cross-protocol: a top-level tool_reference block in a user message converts to Chat Completions dropping the block with one unsupported-semantic loss while sibling text survives (N-AN-21).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": { "protocol": "anthropic" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "tools": [
      {
        "name": "get_weather",
        "description": "Get weather",
        "input_schema": {
          "type": "object"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "tool_reference",
            "tool_name": "get_weather"
          },
          {
            "type": "text",
            "text": "Proceed with the discovered tool."
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get weather",
          "parameters": {
            "type": "object"
          }
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "Proceed with the discovered tool."
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0]",
      "field": "type",
      "reason": "unsupported-semantic"
    }
  ],
  "tags": ["cross", "tools", "tool_reference", "request", "n-an-21"]
}
