{
  "name": "responses.nonstream.text-format-loss-request-to-ir",
  "description": "An unrecognized Responses text.format type has no IR equivalent and is dropped with an unmapped-value loss (N-R-14).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "responses" },
  "input": {
    "model": "gpt-4o-mini",
    "text": { "format": { "type": "unsupported_format" } },
    "input": "Hi"
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o-mini",
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Hi" }] }
    ]
  },
  "expected_losses": [
    {
      "path": "text.format.type",
      "field": "type",
      "reason": "unmapped-value"
    }
  ],
  "tags": ["loss", "request", "n-r-14"]
}
