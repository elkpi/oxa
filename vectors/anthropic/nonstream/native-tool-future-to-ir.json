{
  "name": "anthropic.nonstream.native-tool-future-to-ir",
  "description": "命名原生工具 future 整体保留，不要求 input_schema，不生成字段审计损失。",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "m",
    "max_tokens": 32,
    "tools": [
      {"type":"future_20990101","name":"future","config":{"opaque":[1,true,{"x":"y"}]}}
    ],
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "m",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "hi"
          }
        ]
      }
    ],
    "tools": [
      {
        "type": "native",
        "name": "future",
        "source": "anthropic",
        "definition": "{\"type\":\"future_20990101\",\"name\":\"future\",\"config\":{\"opaque\":[1,true,{\"x\":\"y\"}]}}"
      }
    ],
    "params": {
      "max_tokens": 32
    }
  },
  "expected_losses": [],
  "tags": [
    "request",
    "tools",
    "native",
    "n-nt-1",
    "n-nt-2",
    "n-nt-3",
    "n-nt-4"
  ]
}
