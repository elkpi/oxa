{
  "name": "chatcompletions.nonstream.unknown-request-field-to-ir",
  "description": "A present unknown Chat Completions request extension is dropped and reported once.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [{ "role": "user", "content": "Hi" }],
    "unknown_extension": true
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "Hi" }] }]
  },
  "expected_losses": [
    { "path": "unknown_extension", "field": "unknown_extension", "reason": "unmapped-field" }
  ],
  "tags": ["request", "loss", "unknown-field"]
}
