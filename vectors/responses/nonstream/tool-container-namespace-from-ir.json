{
  "name": "responses.nonstream.tool-container-namespace-from-ir",
  "description": "IR tools with container native annotation re-group into a Responses namespace container on encode.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "responses" },
