            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["cross", "request", "responses", "chatcompletions", "prompt_cache_breakpoint"]
