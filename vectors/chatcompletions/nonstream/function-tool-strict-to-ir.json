{
  "name": "chatcompletions.nonstream.function-tool-strict-to-ir",
  "description": "Function tool strictness preserves omission, false, and true.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "example",
    "messages": [{ "role": "user", "content": "hello" }],
    "tools": [
      { "type": "function", "function": { "name": "omitted", "parameters": {} } },
      { "type": "function", "function": { "name": "false_value", "parameters": {}, "strict": false } },
      { "type": "function", "function": { "name": "true_value", "parameters": {}, "strict": true } }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "example",
    "messages": [{ "role": "user", "content": [{ "type": "text", "text": "hello" }] }],
    "tools": [
      { "name": "omitted", "input_schema": {} },
      { "name": "false_value", "input_schema": {}, "strict": false },
      { "name": "true_value", "input_schema": {}, "strict": true }
    ]
  },
  "expected_losses": [],
  "tags": ["tools", "strict", "request"]
}
