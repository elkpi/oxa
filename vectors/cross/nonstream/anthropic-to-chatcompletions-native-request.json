{
  "name": "cross.nonstream.anthropic-to-chatcompletions-native-request",
  "description": "Cross-protocol: Anthropic request with adaptive thinking, xhigh effort, cache_control, and context_management converts to Chat Completions with reasoning_effort xhigh and precise omission losses.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 64000,
    "cache_control": {
      "type": "ephemeral"
    },
    "messages": [
      {
        "role": "user",
        "content": "Analyze complex codebase."
      }
    ],
    "thinking": {
      "type": "adaptive"
    },
    "output_config": {
      "effort": "xhigh"
    },
    "context_management": {
      "edits": [
        {
          "type": "clear_thinking_20251015",
          "keep": "all"
        }
      ]
    }
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 64000,
    "messages": [
      {
        "role": "user",
        "content": "Analyze complex codebase."
      }
    ],
    "reasoning_effort": "xhigh"
  },
  "expected_losses": [
    {
      "path": "native[0]",
      "field": "type",
      "reason": "unmapped-field"
    },
    {
      "path": "native[2]",
      "field": "cache_control",
      "reason": "unmapped-field"
    },
    {
      "path": "native[3]",
      "field": "context_management",
      "reason": "unsupported-semantic"
    }
  ],
  "tags": [
    "cross",
    "request",
    "effort",
    "native",
    "loss"
  ]
}
