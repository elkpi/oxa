{
  "name": "chatcompletions.nonstream.prompt-cache-key-request-from-ir",
  "description": "IR prompt_cache_key native option renders on Chat Completions request wire (spec/15 §3.7).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": { "protocol": "chatcompletions" },
  "target": { "protocol": "chatcompletions" },
  "input": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ],
    "native": [
      {
        "source": "openai",
        "kind": "prompt_cache_key",
        "value": "\"tenant-42\""
      }
    ]
  },
  "expected_output": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "prompt_cache_key": "tenant-42"
  },
  "expected_losses": [],
  "tags": ["request", "native", "prompt_cache_key"]
}
