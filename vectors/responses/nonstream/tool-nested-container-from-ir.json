            "type": "namespace",
            "name": "editor",
            "description": "Editor tools",
            "tools": [
              {
                "type": "function",
                "name": "read",
                "description": "Read file",
                "parameters": {
                  "type": "object"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "expected_losses": [],
