{
  "name": "anthropic.stream.m7-tool-use-to-ir",
  "description": "A tool_use block whose native start carries the canonical empty input placeholder, partial-json deltas including an empty fragment, and a content_block_stop replays its compact IR tool block only at the stop, with the input equal to the exact concatenation of the raw fragments (N-S-10, INV-1).",
  "spec_version": "0.1.0",
  "mode": "stream",
  "conversion": "to-ir",
  "source": { "protocol": "anthropic" },
  "input": {
    "events": [
      { "type": "message_start", "message": { "id": "msg_1", "type": "message", "role": "assistant", "model": "claude-sonnet-4-5", "content": [], "usage": { "input_tokens": 0, "output_tokens": 0 } } },
      { "type": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "toolu_1", "name": "weather", "input": {} } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"city\":" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": " \"P\\u0041ris\", \"days\": 1e+01}" } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "message_delta", "delta": { "stop_reason": "tool_use" }, "usage": { "input_tokens": 12, "output_tokens": 7 } },
      { "type": "message_stop" }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "events": [
      { "type": "message_start", "id": "msg_1", "model": "claude-sonnet-4-5" },
      { "type": "content_block_start", "index": 0, "block": { "type": "tool_use", "id": "toolu_1", "name": "weather", "input": "{\"city\": \"P\\u0041ris\", \"days\": 1e+01}" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"city\":" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": " \"P\\u0041ris\", \"days\": 1e+01}" } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "message_delta", "stop_reason": "tool_use", "usage": { "input_tokens": 12, "output_tokens": 7 } },
      { "type": "message_done" }
    ]
  },
  "expected_losses": [],
  "tags": ["tools", "stream", "m7", "raw-json", "n-s-10", "inv-1"]
