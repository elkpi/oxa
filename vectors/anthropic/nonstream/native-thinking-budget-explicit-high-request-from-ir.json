{
  "name": "anthropic.nonstream.native-thinking-budget-explicit-high-request-from-ir",
  "description": "IR request with enabled budget and explicit effort restores both on Anthropic encode.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "specVersion": "0.2.0",
    "model": "claude-3-7-sonnet-20250219",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Solve."
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 16000,
      "reasoning_effort": "high"
    },
    "native": [
      {
        "source": "anthropic",
        "kind": "thinking_mode",
        "value": "\"enabled\"",
        "omission": {
          "field": "type",
          "reason": "unmapped-field"
        }
      },
      {
        "source": "anthropic",
        "kind": "thinking_budget",
        "value": "2048",
        "omission": {
          "field": "budget_tokens",
          "reason": "unmapped-field"
        }
      },
      {
        "source": "anthropic",
        "kind": "output_effort",
        "value": "\"high\"",
        "projection": {
          "origin": "explicit",
          "effort": "high"
        }
      }
    ]
  },
  "expected_output": {
    "model": "claude-3-7-sonnet-20250219",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Solve."
      }
    ],
    "thinking": {
      "type": "enabled",
      "budget_tokens": 2048
    },
    "output_config": {
      "effort": "high"
    }
  },
  "expected_losses": [],
  "tags": [
    "request",
    "thinking",
    "budget",
    "effort",
    "native"
  ]
}
