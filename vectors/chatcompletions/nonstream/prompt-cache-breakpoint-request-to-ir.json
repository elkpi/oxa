{
  "name": "chatcompletions.nonstream.prompt-cache-breakpoint-request-to-ir",
  "description": "Chat Completions prompt_cache_breakpoint on content part is preserved as an OpenAI native option (spec/15 §3.7).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello",
            "native": [
              {
                "source": "openai",
                "kind": "prompt_cache_breakpoint",
                "value": "{\"mode\":\"explicit\"}",
                "omission": {
                  "field": "prompt_cache_breakpoint",
                  "reason": "unmapped-field",
                  "detail": "Anthropic Messages has no prompt_cache_breakpoint parameter; prompt cache breakpoint is dropped"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["request", "native", "prompt_cache_breakpoint"]
}
