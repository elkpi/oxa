{
  "name": "chatcompletions.nonstream.images-to-ir",
  "description": "Chat Completions image_url parts convert by N-CC-3: a data:image/png;base64 URL becomes an IR image with media type and data, an https URL becomes an IR URL image.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": { "protocol": "chatcompletions" },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          { "type": "image_url", "image_url": { "url": "data:image/png;base64,aGVsbG8=" } },
          { "type": "image_url", "image_url": { "url": "https://example.com/cat.png" } }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in these pictures?" },
          { "type": "image", "media_type": "image/png", "data": "aGVsbG8=" },
          { "type": "image", "url": "https://example.com/cat.png" }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": ["image", "request", "n-cc-2", "n-cc-3"]
}
