{
  "name": "cross.nonstream.anthropic-to-responses-unnamed-schema-request",
  "description": "An unnamed Anthropic schema cannot be represented in Responses without synthesis.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "anthropic"},
  "target": {"protocol": "responses"},
  "input": {"model": "claude", "max_tokens": 64, "messages": [{"role": "user", "content": "hi"}], "output_config": {"format": {"type": "json_schema", "schema": {"type": "object"}}}},
  "expected_output": {"model": "claude", "max_output_tokens": 64, "input": "hi"},
  "expected_losses": [{"path": "params.response_format", "field": "name", "reason": "unsupported-semantic"}],
  "tags": ["cross", "request", "format", "loss"]
}
