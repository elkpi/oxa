{
  "name": "cross.nonstream.responses-to-anthropic-verbosity",
  "description": "Anthropic cannot represent Responses verbosity and reports a loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "responses"},
  "target": {"protocol": "anthropic"},
  "input": {"model": "m", "input": "Hi", "max_output_tokens": 16, "text": {"verbosity": "high"}},
  "expected_output": {"model": "m", "messages": [{"role": "user", "content": "Hi"}], "max_tokens": 16},
  "expected_losses": [{"path": "params.verbosity", "field": "verbosity", "reason": "unmapped-field"}],
  "tags": ["cross", "request", "verbosity", "loss"]
}
