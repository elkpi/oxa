{
  "name": "anthropic.nonstream.native-context-unknown-enum-request-to-ir",
  "description": "Unknown keep value in clear_thinking edit is dropped with an unmapped-value loss without retaining the edit.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": "Question."
      }
    ],
    "context_management": {
      "edits": [
        {
          "type": "clear_thinking_20251015",
          "keep": "future_keep_enum"
        }
      ]
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Question."
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 16000
    }
  },
  "expected_losses": [
    {
      "path": "context_management.edits[0].keep",
      "field": "keep",
      "reason": "unmapped-value"
    }
  ],
  "tags": [
    "request",
    "context-management",
    "loss"
  ]
}
